# Public Atlas OS website (build-time settings only)
#
# Copy to atlas-os-website/.env and provide real values for local development,
# or set these during the website build on your hosting CI.
# These two values are PUBLIC and will appear in the browser bundle. Do not
# place Resend, Turnstile secret, or Supabase service-role credentials here.

# URL of the separately deployed Supabase Edge Function.
PUBLIC_LEAD_ENDPOINT=

# Cloudflare Turnstile PUBLIC site key authorized for this website hostname.
PUBLIC_TURNSTILE_SITE_KEY=
