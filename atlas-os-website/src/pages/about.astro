---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import { 
  ShieldCheck, 
  Zap, 
  Target, 
  CheckCircle2, 
  Sparkles, 
  ArrowRight,
  Database
} from 'lucide-react';
---

<BaseLayout 
  title="About Us | Our Story & Engineering Philosophy | Atlas OS"
  description="Learn why Atlas OS was founded to replace bloated, legacy ERPs with a lightning-fast, AI-native operating system Story designed specifically for electrical, electronics, and hardware enterprises."
  canonicalUrl="https://atlasos.business/about"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50 relative overflow-hidden">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          <Sparkles className="w-3.5 h-3.5 mr-1 text-brand-700" />
          The Atlas OS Story
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-content-primary tracking-tight font-heading leading-tight">
          Rethinking ERP from first principles for <span class="text-gradient">real business velocity</span>.
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Wholesale distributors and retailers in electrical, electronics, and hardware deserve software engineered with the same precision, speed, and elegance as consumer technology.
        </p>
      </div>
    </Container>
  </section>

  <!-- Problem & Origin Story -->
  <section class="py-18 md:py-24 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-bold uppercase tracking-wider bg-coral-100 text-coral-700">
            The Industry Dilemma
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading tracking-tight">
            Why are business owners still trapped in 1995 software?
          </h2>
          <div class="space-y-4 text-content-secondary text-sm sm:text-base leading-relaxed">
            <p>
              For decades, electrical distributors, hardware suppliers, and trade counter merchants have been forced into a frustrating compromise. On one side are thirty-year-old desktop accounting packages: rigid, complex to configure, fragile across networks, and requiring manual offline backups on USB drives.
            </p>
            <p>
              On the other side are modern cloud SaaS tools designed for Silicon Valley tech startups—completely detached from the practical realities of high-volume counter sales, multi-unit conversions (boxes vs. meters), customer credit periods, and complex multi-rate GST compliance.
            </p>
            <p>
              When a busy contractor is standing at your trade counter at 10 AM demanding spools of cable, MCBs, and credit billing against a pending purchase order, you cannot afford a slow spinning wheel or a convoluted ten-click dialog.
            </p>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-surface-dark rounded-3xl p-8 sm:p-10 text-white shadow-xl relative overflow-hidden border border-brand-500/20">
            <h3 class="text-xl font-bold font-heading text-brand-300 mb-4 flex items-center gap-2">
              <Target className="w-5 h-5 text-brand-400" />
              Our Foundational Mission
            </h3>
            <blockquote class="text-lg sm:text-xl italic font-medium leading-relaxed text-slate-100 mb-6">
              "To eliminate friction from everyday commerce by engineering the most dependable, lightning-fast, and intuitive operating system for wholesale trade."
            </blockquote>
            <div class="space-y-3 pt-4 border-t border-navy-700 text-xs sm:text-sm text-slate-300">
              <div class="flex items-center gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Zero unnecessary bloat: Only features that accelerate everyday workflows.</span>
              </div>
              <div class="flex items-center gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Sub-second counter checkout with seamless keyboard navigation.</span>
              </div>
              <div class="flex items-center gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Rock-solid financial accuracy with automated reconciliation.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Core Engineering Values -->
  <section class="py-18 md:py-24 bg-surface-secondary border-y border-border">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16 space-y-3">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          Our Core Principles
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          Engineered on uncompromising standards
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          We treat business accounting and inventory management with mission-critical engineering rigor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Principle 1 (Mint) -->
        <div class="p-8 rounded-3xl bg-white border border-mint-200 hover:border-mint-300 transition-all shadow-sm group space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-mint-100 text-mint-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Database className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Mathematical Ledger Integrity</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Every invoice, receipt, and stock movement is backed by immutable database contracts and strict PostgreSQL transactions. Double-entry consistency is mathematically guaranteed, not approximated in JavaScript.
          </p>
        </div>

        <!-- Principle 2 (Sky) -->
        <div class="p-8 rounded-3xl bg-white border border-sky-200 hover:border-sky-300 transition-all shadow-sm group space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <Zap className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Extreme Keyboard Velocity</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Speed is a feature. We design counter POS workflows so seasoned operators never have to touch a mouse. Rapid barcode scanning, fuzzy search, and keyboard shortcuts keep customer queues moving.
          </p>
        </div>

        <!-- Principle 3 (Lavender) -->
        <div class="p-8 rounded-3xl bg-white border border-lavender-200 hover:border-lavender-300 transition-all shadow-sm group space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-lavender-100 text-lavender-700 flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
            <ShieldCheck className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Honest, Transparent Architecture</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            We never publish fake download buttons or exaggerate capabilities. Our release manifests, feature development roadmaps, and pricing terms are published openly for full stakeholder scrutiny.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Real Verification Metrics -->
  <section class="py-18 md:py-24 bg-white">
    <Container>
      <div class="bg-gradient-to-r from-brand-700 via-brand-600 to-brand-800 rounded-3xl p-10 sm:p-14 text-white shadow-xl relative overflow-hidden">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white/20 text-white border border-white/30 backdrop-blur-sm mb-4">
            Automated Quality Assurance
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-heading mb-4">
            Tested before every release. Guaranteed in production.
          </h2>
          <p class="text-brand-100 leading-relaxed mb-8 text-sm sm:text-base">
            Every feature update in Atlas OS passes through a comprehensive CI/CD verification matrix before reaching your warehouse or counter:
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
            <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15">
              <div class="text-3xl font-black text-white font-heading">82+</div>
              <div class="text-xs text-brand-100 mt-1 uppercase tracking-wider font-semibold">PostgreSQL Contracts</div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15">
              <div class="text-3xl font-black text-white font-heading">540+</div>
              <div class="text-xs text-brand-100 mt-1 uppercase tracking-wider font-semibold">Unit & Logic Tests</div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15">
              <div class="text-3xl font-black text-white font-heading">43+</div>
              <div class="text-xs text-brand-100 mt-1 uppercase tracking-wider font-semibold">E2E Browser Scenarios</div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15">
              <div class="text-3xl font-black text-white font-heading">100%</div>
              <div class="text-xs text-brand-100 mt-1 uppercase tracking-wider font-semibold">Row-Level Security</div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section class="py-18 bg-surface-secondary border-t border-border">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          Ready to experience modern business velocity?
        </h2>
        <p class="text-content-secondary leading-relaxed text-sm sm:text-base">
          See why electrical and hardware distributors are switching to Atlas OS. Request a personalized walkthrough or explore our transparent pricing.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <Button href="/request-demo" variant="primary" size="lg" class="w-full sm:w-auto font-bold">
            <span>Schedule a Live Demo</span>
            <ArrowRight className="w-4 h-4 ml-2" />
          </Button>
          <Button href="/pricing" variant="outline" size="lg" class="w-full sm:w-auto font-semibold">
            <span>View Pricing & Plans</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
