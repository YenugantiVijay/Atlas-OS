---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import ReceiptTemplates from '../components/receipts/ReceiptTemplates';
---

<BaseLayout title="Receipt Templates | Atlas OS" description="Preview a payment receipt with your business logo, address, and message. Compare customer-only and two-copy layouts.">
  <section class="border-b border-border bg-radial-glow py-10 sm:py-14">
    <Container>
      <div class="mx-auto max-w-3xl text-center" data-enter>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Receipt templates</h1>
        <p class="mt-3 text-sm leading-relaxed text-content-secondary sm:text-base">Try a Classic or Compact receipt with your own logo and business details.</p>
      </div>
    </Container>
  </section>
  <section class="bg-surface-secondary/50 py-8 sm:py-12">
    <Container>
      <div class="mx-auto max-w-5xl"><ReceiptTemplates client:load /></div>
    </Container>
  </section>
</BaseLayout>
