---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import ReleaseCard from '../components/download/ReleaseCard';
import { INDUSTRY_TOOLS, industryDownloadHref, industryLaunch } from '../data/industry-downloads';
import { OFFICIAL_RELEASES, APP_CONFIG } from '../data/releases';

const appLaunch = industryLaunch('electrical');
const onlineUrl = appLaunch ? new URL(appLaunch.url) : null;
// The general installation centre must preserve the tenant's default workspace.
onlineUrl?.searchParams.delete('tool');
const installUrl = onlineUrl ? new URL('/install.html', onlineUrl).href : null;
const windowsRelease = OFFICIAL_RELEASES.find((r) => r.platform === 'Windows') || OFFICIAL_RELEASES[0];
---

<BaseLayout
  title="Download Atlas OS — Official Software Distribution Center"
  description="Check the Windows release status, view requirements, and request a walkthrough of Atlas OS."
>
  <section class="border-b border-border bg-white py-12" id="installation-centre">
    <Container size="default">
      <h2 class="font-heading text-3xl font-bold">Atlas OS — Your Business. One Platform.</h2>
      <p class="my-4 text-content-secondary">Install Atlas OS as an online-first web application in Chrome or Microsoft Edge.</p>
      {installUrl ? <div class="flex flex-wrap gap-3"><Button href={installUrl} variant="primary">Install Atlas OS</Button><Button href={onlineUrl?.href} variant="outline">Continue Online</Button></div> : <p>Online installation links will be available when the application hosting URL is configured.</p>}
      <p class="mt-4 text-sm text-content-secondary">On Windows, open the application and use Edge Menu → Apps → Install this site as an app, or Chrome's address bar installation icon. A current browser, HTTPS, browser storage, and internet access are required for business operations. The Installation Centre shows the current application version, update instructions, and troubleshooting. Native desktop installers remain planned.</p>
    </Container>
  </section>
  {/* HERO */}
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50">
    <Container size="default">
      <div data-enter class="text-center max-w-3xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          Official Software Distribution Center
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold font-heading tracking-tight text-content-primary">
          Download <span class="text-gradient">Atlas OS</span>
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Choose your industry to open its workspace or get a Windows browser shortcut.
        </p>
      </div>
    </Container>
  </section>

  <section class="border-b border-border bg-white py-12">
    <Container size="wide">
      <h2 class="mb-5 font-heading text-2xl font-bold">Industry tools</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {Object.entries(INDUSTRY_TOOLS).map(([id, tool]) => (
          <li><a href={industryDownloadHref(id)} class="block h-full rounded-xl border border-border p-4 hover:border-brand-500">
            <span class="block font-semibold text-content-primary">{tool.name}</span>
            <span class="mt-1 block text-sm text-content-secondary">{tool.headline}</span>
          </a></li>
        ))}
      </ul>
    </Container>
  </section>

  {/* MAIN DOWNLOAD CARD & RELEASE MANIFEST */}
  <section class="py-16 bg-surface-secondary border-b border-border" id="status">
    <Container size="narrow">
      <ReleaseCard client:load release={windowsRelease} webAppUrl={APP_CONFIG.webAppUrl} />
    </Container>
  </section>

  {/* CTA */}
  <section class="py-16 bg-surface-secondary">
    <Container size="default">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <h3 class="text-2xl font-bold font-heading text-content-primary">See how Atlas OS works</h3>
        <p class="text-sm text-content-secondary leading-relaxed">
          Explore the empty workspace preview in your browser, or ask about access for your business.
        </p>
        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <Button href="/request-demo" variant="primary" size="md" class="font-semibold">
            <span>Request Demo Access</span>
          </Button>
          <Button href="/#product-preview" variant="outline" size="md" class="font-semibold">
            <span>Try the interactive preview</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
