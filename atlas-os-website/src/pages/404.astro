---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Badge from '../components/common/Badge.astro';
import Button from '../components/common/Button.astro';
import { Home, FileQuestion, HelpCircle, Download } from 'lucide-react';
---

<BaseLayout 
  title="404 — Page Not Found | Atlas OS"
  description="The page you requested could not be found. Explore Atlas OS features, solutions, download center, or request a live demonstration."
>
  <section class="min-h-[75vh] flex items-center justify-center pt-32 pb-20 bg-surface relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-50 pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <Container>
      <div class="max-w-xl mx-auto text-center relative z-10 space-y-6">
        <Badge variant="warning" className="mx-auto">
          <FileQuestion className="w-3.5 h-3.5 mr-1.5" />
          Error 404: Resource Relocated or Missing
        </Badge>
        
        <h1 class="text-6xl sm:text-7xl font-black font-display text-text-primary tracking-tight">
          Page Not Found
        </h1>
        
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          The page or documentation file you were searching for does not exist, has been reorganized, or was entered incorrectly.
        </p>

        <!-- Quick Route Navigation -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
          <Button href="/" variant="primary" size="md">
            <Home className="w-4 h-4 mr-2" />
            Return to Homepage
          </Button>
          <Button href="/download" variant="outline" size="md">
            <Download className="w-4 h-4 mr-2" />
            Download Center
          </Button>
          <Button href="/support" variant="ghost" size="md">
            <HelpCircle className="w-4 h-4 mr-2" />
            Help & FAQs
          </Button>
        </div>

        <!-- Helpful directory links -->
        <div class="pt-8 border-t border-border-subtle text-xs text-text-muted">
          <p class="font-semibold text-text-secondary mb-3 uppercase tracking-wider">Helpful Navigation Links</p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="/product" class="hover:text-brand-600 transition-colors">Product Overview</a>
            <span>•</span>
            <a href="/features" class="hover:text-brand-600 transition-colors">Features Directory</a>
            <span>•</span>
            <a href="/solutions" class="hover:text-brand-600 transition-colors">Industry Solutions</a>
            <span>•</span>
            <a href="/pricing" class="hover:text-brand-600 transition-colors">Pricing & Plans</a>
            <span>•</span>
            <a href="/request-demo" class="hover:text-brand-600 transition-colors">Book a Demo</a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
