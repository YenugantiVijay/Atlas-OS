---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import { 
  ShieldCheck, 
  Lock, 
  Database, 
  FileCheck2, 
  Server, 
  ArrowRight, 
  UserCheck, 
  FileSpreadsheet
} from 'lucide-react';
---

<BaseLayout 
  title="Security, Privacy & Data Architecture | Atlas OS"
  description="Review Atlas OS PostgreSQL Row-Level Security and role-based controls, plus the hosted configuration that must be verified for each deployment."
  canonicalUrl="https://atlasos.business/security"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50 relative overflow-hidden">
    <Container>
      <div data-enter class="max-w-3xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          <ShieldCheck className="w-3.5 h-3.5 mr-1 text-brand-700" />
          Technical Security Architecture
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-content-primary tracking-tight font-heading leading-tight">
          Security controls, <span class="text-gradient">clearly scoped</span>.
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Atlas OS uses organization-scoped database policies and role-aware application workflows. Hosted function privileges, credential protections, and recovery settings vary by environment and must be reviewed before production use.
        </p>
      </div>
    </Container>
  </section>

  <!-- Technical Defense Pillars -->
  <section class="py-18 md:py-24 bg-white">
    <Container>
      <div data-reveal class="max-w-3xl mx-auto text-center mb-16 space-y-3">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-navy-100 text-navy-800">
          Architectural Controls
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          How Atlas OS protects your enterprise data
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Product controls are only one part of security; hosting configuration and operational verification matter too.
        </p>
      </div>

      <div data-reveal-group class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Control 1: RLS -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-4">
            <Database className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">PostgreSQL Row-Level Security</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed mb-4">
            Database migrations define organization-scoped Row-Level Security policies. Review the deployed policies and elevated database functions for your project; this page is not a production configuration attestation.
          </p>
          <div class="bg-surface-dark rounded-xl p-3 font-mono text-xs text-brand-300 border border-navy-700">
            <code>organization membership + row policy</code>
          </div>
        </div>

        <!-- Control 2: 6 RBAC Tiers -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4">
            <UserCheck className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">6-Tier Granular RBAC</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            The app maps owner, admin, sales, inventory, accounts, and viewer roles to different actions. Application permissions are not a substitute for checking database function privileges and policies.
          </p>
        </div>

        <!-- Control 3: Formula Injection Protection -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-lavender-100 text-lavender-700 flex items-center justify-center mb-4">
            <FileSpreadsheet className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Spreadsheet Formula Sanitization</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Supported spreadsheet exports sanitize formula-leading values. Review custom export paths whenever new fields or formats are added.
          </p>
        </div>

        <!-- Control 4: Encryption in Transit & Rest -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
            <Lock className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Transport & Storage Encryption</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Public website delivery uses HTTPS. TLS versions, database storage encryption, and snapshot protections depend on the selected hosting plans and must be confirmed in deployment settings.
          </p>
        </div>

        <!-- Control 5: Immutable Audit Ledger -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
            <FileCheck2 className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Business Audit Events</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Audit events are recorded for supported actions. Coverage, retention, and tamper resistance depend on the workflow and deployed database policies; not every record is an immutable ledger.
          </p>
        </div>

        <!-- Control 6: High Availability & Backups -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-mint-100 text-mint-700 flex items-center justify-center mb-4">
            <Server className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Backup & Recovery Readiness</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Backup retention and point-in-time recovery depend on the hosted database plan and configuration. Confirm recovery settings and test a restore before relying on them for production.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Detailed RBAC Matrix Table -->
  <section class="py-18 md:py-24 bg-surface-secondary border-y border-border">
    <Container>
      <div data-reveal class="max-w-3xl mx-auto text-center mb-16 space-y-3">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          Access Governance
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          Application Permission Roles
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Summary of the app's role permissions. Hosted database policies and function privileges require separate verification.
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-border bg-white shadow-sm">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-surface-secondary border-b border-border">
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Role</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Inventory Writes</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Supplier Price Access</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Quotes & Orders</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Invoices & Payments</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Financial Reports</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Owner</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Manage</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Read / Record</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Confirm</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Issue / Record</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Yes</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Admin</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Manage</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Read / Record</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Confirm</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Issue / Record</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Yes</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Sales</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Confirm</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Inventory</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Manage</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Read / Record</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Accounts</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-content-secondary">Read</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create / Issue / Record</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Yes</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Viewer</td>
              <td class="p-4 sm:p-5 text-content-secondary">No write</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
              <td class="p-4 sm:p-5 text-content-secondary">No write</td>
              <td class="p-4 sm:p-5 text-content-secondary">No write</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">No</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-white border-t border-border">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-content-primary">
          Review your deployment's security and recovery setup
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Schedule a demo to review the product controls and discuss hosted-environment requirements.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/request-demo" variant="primary" size="lg" class="font-bold">
            <span>Schedule a Live Demo</span>
            <ArrowRight className="w-4 h-4 ml-2" />
          </Button>
          <Button href="/contact" variant="outline" size="lg" class="font-semibold">
            <span>Contact Atlas OS</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
