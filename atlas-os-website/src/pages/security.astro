---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import { 
  ShieldCheck, 
  Lock, 
  Database, 
  FileCheck2, 
  Server, 
  ArrowRight, 
  UserCheck, 
  FileSpreadsheet
} from 'lucide-react';
---

<BaseLayout 
  title="Security, Privacy & Data Architecture | Atlas OS"
  description="Explore the technical security controls, multi-tenant isolation, PostgreSQL Row-Level Security, and cryptographic protections engineered into Atlas OS."
  canonicalUrl="https://atlasos.business/security"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50 relative overflow-hidden">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          <ShieldCheck className="w-3.5 h-3.5 mr-1 text-brand-700" />
          Technical Security Architecture
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-content-primary tracking-tight font-heading leading-tight">
          Enterprise-grade protection for <span class="text-gradient">every business transaction</span>.
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Your customer lists, purchase margins, bank receipts, and inventory records are safeguarded by cryptographic authentication, strict multi-tenant database isolation, and rigorous code audit standards.
        </p>
      </div>
    </Container>
  </section>

  <!-- Technical Defense Pillars -->
  <section class="py-18 md:py-24 bg-white">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16 space-y-3">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-navy-100 text-navy-800">
          Architectural Controls
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          How Atlas OS protects your enterprise data
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          We implement defense-in-depth across the application, database, and export layers.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Control 1: RLS -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-4">
            <Database className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">PostgreSQL Row-Level Security</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed mb-4">
            Multi-tenant boundary enforcement is hardwired directly into the database engine. Every single SQL query executes with authenticated tenant context:
          </p>
          <div class="bg-surface-dark rounded-xl p-3 font-mono text-xs text-brand-300 border border-navy-700">
            <code>WHERE organization_id = auth.uid()</code>
          </div>
        </div>

        <!-- Control 2: 6 RBAC Tiers -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4">
            <UserCheck className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">6-Tier Granular RBAC</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Strict role-based access control segregates operations. Counter cashiers cannot view supplier purchase costs; inventory clerks cannot alter customer balances; only designated financial officers can approve write-offs.
          </p>
        </div>

        <!-- Control 3: Formula Injection Protection -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-lavender-100 text-lavender-700 flex items-center justify-center mb-4">
            <FileSpreadsheet className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Spreadsheet Formula Sanitization</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            All customer names, product descriptions, and remarks exported to Excel/CSV are sanitized against CSV Injection (Formula Injection). Characters like <code>=</code>, <code>+</code>, <code>-</code>, and <code>@</code> are safely escaped.
          </p>
        </div>

        <!-- Control 4: Encryption in Transit & Rest -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
            <Lock className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Cryptographic Encryption</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            All communications are encrypted using TLS 1.3 in transit with strict HTTPS redirection and HSTS headers. Database storage volumes and automatic snapshots are protected using AES-256 encryption at rest.
          </p>
        </div>

        <!-- Control 5: Immutable Audit Ledger -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
            <FileCheck2 className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Immutable Financial Audit Logs</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Every finalized invoice, partial payment allocation, and inventory adjustment creates an append-only transaction record. Financial records cannot be secretly deleted or altered retroactively.
          </p>
        </div>

        <!-- Control 6: High Availability & Backups -->
        <div class="p-8 rounded-3xl bg-surface-secondary/50 border border-border hover:border-brand-300 transition-all shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-mint-100 text-mint-700 flex items-center justify-center mb-4">
            <Server className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-content-primary font-heading">Continuous Cloud Backup</h3>
          <p class="text-content-secondary text-xs sm:text-sm leading-relaxed">
            Never risk losing your enterprise books to a damaged hard drive or stolen laptop. Atlas OS databases feature automated Point-in-Time Recovery (PITR) with continuous transactional write-ahead log archiving.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Detailed RBAC Matrix Table -->
  <section class="py-18 md:py-24 bg-surface-secondary border-y border-border">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16 space-y-3">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          Access Governance
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-heading">
          Granular Permission Roles Matrix
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Configure exact operational boundaries for every employee in your organization.
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-border bg-white shadow-sm">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-surface-secondary border-b border-border">
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Role</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Point of Sale / Billing</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Customer Balances</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Inventory Stock In</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Supplier Costs</th>
              <th class="p-4 sm:p-5 font-bold font-heading text-content-primary">Financial Exports</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Owner / Director</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">General Manager</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Accountant</td>
              <td class="p-4 sm:p-5 text-content-secondary">Read-Only</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Reconcile / Edit</td>
              <td class="p-4 sm:p-5 text-content-secondary">Read-Only</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">View / Verify</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Full Access</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Counter Cashier</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Create Invoices</td>
              <td class="p-4 sm:p-5 text-content-secondary">View Due Only</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted (Hidden)</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Warehouse Clerk</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Record GRN</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted (Hidden)</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-content-primary">Sales Representative</td>
              <td class="p-4 sm:p-5 text-emerald-600 font-semibold">Draft Estimates</td>
              <td class="p-4 sm:p-5 text-content-secondary">Assigned Accounts</td>
              <td class="p-4 sm:p-5 text-content-secondary">Stock Availability</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted (Hidden)</td>
              <td class="p-4 sm:p-5 text-rose-500 font-semibold">Restricted</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-white border-t border-border">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold font-heading text-content-primary">
          Experience secure, reliable business operations
        </h2>
        <p class="text-content-secondary text-sm sm:text-base">
          Schedule a personalized live demo or speak with our product architects today.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/request-demo" variant="primary" size="lg" class="font-bold">
            <span>Schedule a Live Demo</span>
            <ArrowRight className="w-4 h-4 ml-2" />
          </Button>
          <Button href="/contact" variant="outline" size="lg" class="font-semibold">
            <span>Contact Security Desk</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
