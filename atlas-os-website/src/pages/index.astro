                <ul class="space-y-1.5 text-xs">
                  {sol.howAtlasSolves.slice(0, 3).map((soln) => (
                    <li class="flex items-start gap-2 text-content-primary">
                      <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                      <span>{soln}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-border/50">
              <a
                href={`/solutions#${sol.id}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-800"
              >
                <span>Read Full Industry Workflow</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* SECTION 6: SECURITY ARCHITECTURE — DEEP NAVY CONTRAST SECTION */}
  <section class="py-18 md:py-24 bg-surface-dark text-white relative overflow-hidden border-b border-navy-800">
    <div class="absolute inset-0 bg-radial-glow-dark opacity-60 pointer-events-none"></div>
