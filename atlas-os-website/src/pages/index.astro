---
import { ArrowDown, ArrowRight, Banknote, Boxes, Calculator, ChartNoAxesColumnIncreasing, ChevronDown, FileText, ListChecks, Receipt, ShieldCheck, ShoppingCart, TrendingUp, Users } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Container from '../components/common/Container.astro';
import IndustryLinks from '../components/common/IndustryLinks.astro';
import InteractivePreview from '../components/home/InteractivePreview';
import { PRICING_TIERS } from '../data/pricing';

const features = [
  { title: 'Keep Track of Your Stock', text: 'Record deliveries and check what is available before you promise it to a customer.', href: '/features#inventory', Icon: Boxes, color: '#0f766e', tint: '#edf8f5' },
  { title: 'Manage Customer Orders', text: 'Find products, prepare a quotation, and follow the order from confirmation to billing.', href: '/features', Icon: ShoppingCart, color: '#1d4ed8', tint: '#eff5fc' },
  { title: 'Handle Your Invoices', text: 'Create GST invoices with the customer, item, and tax details in one place.', href: '/features#invoicing', Icon: FileText, color: '#7c3aed', tint: '#f5f1fb' },
  { title: 'Track Customer Payments', text: 'Record a payment, print a receipt, and see which invoices still have a balance.', href: '/features#payments', Icon: Banknote, color: '#a16207', tint: '#fff7ed' },
  { title: 'Understand Your Business', text: 'Review sales and customer dues, then export the reports you need to share.', href: '/features#reports', Icon: ChartNoAxesColumnIncreasing, color: '#0369a1', tint: '#edf7fa' },
];
const heroTopics = ['Check stock availability', 'Create GST invoices', 'Track customer payments'];
const controls = [
  { Icon: Users, title: 'Access by role', text: 'Give sales, inventory, and accounts staff access to the work they handle.' },
  { Icon: ListChecks, title: 'A record of changes', text: 'Review audit events for supported business actions.' },
  { Icon: FileText, title: 'Reports you can export', text: 'Download supported sales, stock, and payment reports to review or share.' },
];
const starter = PRICING_TIERS.find(plan => plan.id === 'starter')!;
const faqs = [
  ['What is Atlas OS?', 'It’s a workspace for shops, wholesalers, and distributors. You can receive stock, prepare orders, create invoices, and record payments from the same workspace.'],
  ['Can I start with one shop?', 'Yes. Atlas Sprout covers the everyday stock, sales, and collections workflow, including a branded customer receipt.'],
  ['What happens when a supplier changes a price?', 'Atlas Stride includes supplier price history and a review queue for affected quotes. Your team decides which quotes need updating.'],
  ['How can I try it?', 'Use the interactive preview on this page, or request a guided demo and bring a sample sale or stock delivery to walk through.'],
];
---

<BaseLayout title="Atlas OS | Stock and GST billing for shops and distributors"
  description="Atlas OS connects stock, quotations, GST invoices, and customer payments for Indian retailers, wholesalers, and distributors.">
  <section id="home-overview" class="hero-shell border-b border-border" aria-labelledby="home-title">
    <Container size="default">
      <div class="hero-intro">
        <p class="hero-audience" data-enter>ERP for Indian retailers, wholesalers, and distributors</p>
        <h1 id="home-title" class="hero-title font-heading" data-enter>Manage stock, GST billing, and payments in one place.</h1>
        <div class="hero-topics" data-hero-topics={JSON.stringify(heroTopics)} aria-hidden="true">
          {heroTopics.map(topic => <span class="hero-topic-size">{topic}</span>)}
          <span class="hero-topic-active"><span data-hero-word>{heroTopics[0]}</span><span class="hero-caret"></span></span>
        </div>
        <p class="hero-description">Check availability, turn quotes into GST invoices, and follow outstanding balances from the same workspace.</p>
        <div class="hero-actions">
          <Button href="/request-demo" variant="primary" size="lg" class="!bg-brand-700 hover:!bg-brand-800">Request a Demo <ArrowRight size={18} aria-hidden="true" /></Button>
          <Button href="#product-preview" variant="outline" size="lg">See Atlas OS in action <ArrowDown size={17} aria-hidden="true" /></Button>
        </div>
      </div>
    </Container>
  </section>

  <section class="home-section" id="daily-workflow">
    <Container size="wide">
      <div class="section-intro" data-reveal>
        <h2 class="home-heading">Tools for each step of a sale</h2>
        <p class="home-description">From receiving a delivery to collecting payment, your team can pick up where the last person left off.</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5" data-reveal-group>
        {features.map(({ title, text, href, Icon, color, tint }) => <li>
          <a href={href} style={`--icon-accent:${color};--tile-tint:${tint}`} class="home-card atlas-icon-card flex h-full flex-col items-start gap-3 rounded-2xl border border-border p-5 lg:p-6">
            <span class="atlas-card-icon grid h-11 w-11 place-items-center rounded-xl"><Icon size={22} aria-hidden="true" /></span>
            <div><h3 class="font-heading text-base font-bold">{title}</h3><p class="mt-2 text-sm leading-relaxed text-content-secondary">{text}</p></div>
            <ArrowRight size={18} className="mt-auto text-brand-700" aria-hidden="true" />
          </a>
        </li>)}
      </ul>
    </Container>
  </section>

  <section class="home-section bg-[#f4f8f9] border-y border-border">
    <Container size="default" class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <h2 class="home-heading">When a supplier rate changes, see which quotes need review.</h2>
        <p class="home-description">Atlas OS keeps a history of supplier prices and flags open quotes that use the affected products. Your team chooses what to update before sending the quote.</p>
        <a href="/features#supplier-rate-review" class="mt-4 inline-flex items-center gap-2 font-semibold text-brand-700 hover:underline">See supplier price review <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="rounded-3xl border border-brand-200 bg-white p-5 shadow-sm sm:p-7" data-reveal>
        <p class="mb-4 flex items-center gap-2 font-heading text-lg font-bold"><TrendingUp size={22} className="text-brand-700" aria-hidden="true" /> Supplier price review</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl bg-surface-secondary p-4"><p class="text-sm text-content-secondary">Review earlier costs</p><p class="mt-1 text-base font-bold">Price history</p></div>
          <div class="rounded-xl bg-brand-50 p-4"><p class="text-sm text-brand-800">Check open quotations</p><p class="mt-1 text-base font-bold text-brand-800">Affected quotes</p></div>
        </div>
        <p class="mt-4 flex items-start gap-2 text-sm font-semibold"><ListChecks size={18} className="shrink-0 text-brand-700" aria-hidden="true" /> Review the open quote before you send it.</p>
      </div>
    </Container>
  </section>

  <section class="home-section" id="product-preview">
    <Container size="default">
      <div class="section-intro" data-reveal>
        <h2 class="home-heading">Connected Business Workflow</h2>
        <p class="home-description">Select a workflow to see how a sample transaction moves through Atlas OS.</p>
      </div>
      <InteractivePreview client:load />
    </Container>
  </section>

  <section class="home-section border-y border-border bg-[#f4f8f9]" id="industries">
    <Container size="default">
      <div class="industry-intro grid items-center gap-8 lg:grid-cols-2 lg:gap-14" data-reveal>
        <div>
          <h2 class="home-heading">Built for businesses that buy, stock, and sell</h2>
          <p class="home-description">At a retail counter, find the item and bill it. In a warehouse, receive deliveries and keep supplier costs up to date. See how Atlas OS fits your business.</p>
          <Button href="/solutions/" variant="outline" class="mt-5">Explore all industries <ArrowRight size={17} aria-hidden="true" /></Button>
        </div>
        <img class="industry-photo" src="/images/electrical-stockroom.webp" width="960" height="640" loading="lazy" decoding="async" alt="Two staff members checking a carton in an electrical wholesale stockroom" />
      </div>
      <div class="mt-8" data-reveal><IndustryLinks /></div>
    </Container>
  </section>

  <section class="home-section" id="business-controls">
    <Container size="default">
      <div class="section-intro" data-reveal>
        <h2 class="home-heading">Know who can do what</h2>
        <p class="home-description">Review access and reporting before you decide how to set up your team.</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-3" data-reveal-group>
        {controls.map(({ Icon, title, text }) => <li class="control-card">
          <Icon size={22} className="text-brand-700" aria-hidden="true" />
          <h3 class="mt-3 font-heading text-lg font-bold">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-content-secondary">{text}</p>
        </li>)}
      </ul>
      <div class="mt-6 text-center" data-reveal>
        <a href="/security" class="inline-flex items-center gap-2 font-semibold text-brand-700 hover:underline"><ShieldCheck size={18} aria-hidden="true" /> Review Atlas OS security <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </Container>
  </section>

  <section class="pb-14 sm:pb-20">
    <Container size="default">
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-brand-200 bg-gradient-to-r from-brand-50 to-white p-6 sm:p-9" data-reveal>
        <div><h2 class="home-heading">A plan for the way you work</h2><p class="home-description">Proposed Atlas Sprout pricing is {starter.priceDisplay}{starter.billingPeriod.replace(' ', '')}. Compare plans for your shop, counter, or distribution team.</p></div>
        <Button href="/pricing" variant="primary" class="!bg-brand-700 hover:!bg-brand-800">Compare plans <ArrowRight size={17} aria-hidden="true" /></Button>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container size="default">
      <div class="section-intro" data-reveal><h2 class="home-heading">Free tools and guides</h2><p class="home-description">Calculate GST, download an invoice format, or get help with a workflow.</p></div>
      <ul class="grid gap-4 sm:grid-cols-3" data-reveal-group>
        {[
          { name: 'Atlas Calculators', text: 'GST, margin, EMI, inventory and more.', href: '/calculators/', Icon: Calculator, tint: '#edf8f5' },
          { name: 'Invoice Formats', text: 'Download Word, Excel, or PDF invoice templates.', href: '/invoice-formats/', Icon: Receipt, tint: '#f5f1fb' },
          { name: 'Help and guides', text: 'Find answers about setup, features and everyday work.', href: '/resources/', Icon: ListChecks, tint: '#eff5fc' },
        ].map(({ name, text, href, Icon, tint }) => <li><a class="home-card atlas-icon-card flex h-full gap-3 rounded-2xl border border-border p-5" style={`--tile-tint:${tint}`} href={href}>
          <span class="atlas-card-icon grid h-10 w-10 shrink-0 place-items-center rounded-lg"><Icon size={20} aria-hidden="true" /></span>
          <div><h3 class="font-heading text-lg font-bold">{name}</h3><p class="mt-1 text-sm leading-relaxed text-content-secondary">{text}</p></div>
        </a></li>)}
      </ul>
    </Container>
  </section>

  <section class="border-y border-border bg-surface-secondary py-12 sm:py-16">
    <Container size="narrow">
      <h2 class="home-heading mb-5" data-reveal>Frequently asked questions</h2>
      <div class="grid gap-3" data-reveal-group>
        {faqs.map(([question, answer]) => <details class="group rounded-2xl border border-border bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-semibold">{question}<ChevronDown size={18} className="shrink-0 text-brand-700 group-open:rotate-180" aria-hidden="true" /></summary>
          <p class="px-4 pb-4 text-sm leading-relaxed text-content-secondary">{answer}</p>
        </details>)}
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container size="default">
      <div class="demo-banner flex flex-wrap items-center justify-between gap-6 rounded-3xl p-6 text-white sm:p-10 lg:p-12" data-reveal>
        <div class="max-w-2xl"><h2 class="home-heading">See Atlas OS with your workflow</h2><p class="mt-2 leading-relaxed text-slate-200">Bring a sample invoice, order, or stock delivery to the walkthrough.</p></div>
        <div class="flex flex-wrap gap-3"><Button href="/request-demo" variant="white" size="lg">Request a Demo</Button><Button href="/product" variant="primary" size="lg" class="!bg-brand-700 hover:!bg-brand-800">Explore Atlas OS</Button></div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const topics = document.querySelector<HTMLElement>('[data-hero-topics]');
  const output = topics?.querySelector('[data-hero-word]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (topics?.dataset.heroTopics && output && !motion.matches) {
    const phrases: string[] = JSON.parse(topics.dataset.heroTopics);
    const start = performance.now();
    const interval = 1500;
    const typingDuration = 560;
    topics.classList.add('is-typing');
    const type = (now: number) => {
      const elapsed = Math.max(0, now - start);
      if (motion.matches || elapsed >= interval * phrases.length) {
        output.textContent = phrases[0];
        topics.classList.remove('is-typing');
        return;
      }
      const phrase = phrases[Math.floor(elapsed / interval)];
      const fraction = Math.min(1, (elapsed % interval) / typingDuration);
      const text = phrase.slice(0, Math.floor(phrase.length * fraction));
      if (output.textContent !== text) output.textContent = text;
      requestAnimationFrame(type);
    };
    requestAnimationFrame(type);
  }
</script>

<style>
  .hero-shell {
    padding-block: clamp(3rem, 6vw, 6rem);
    background: radial-gradient(ellipse at 50% 0%, #ebf6f2, transparent 65%), #fff;
  }
  .hero-intro { max-width: 52rem; margin-inline: auto; text-align: center; }
  .hero-audience { margin-bottom: 1.15rem; color: #14665d; font-size: .875rem; font-weight: 700; }
  .hero-title {
    font-size: clamp(2.15rem, 4.1vw, 3.55rem);
    font-weight: 760;
    line-height: 1.11;
    letter-spacing: -.047em;
    text-wrap: balance;
  }
  .hero-topics {
    display: grid;
    margin: 1.25rem auto 0;
    width: fit-content;
    max-width: 100%;
    padding: .4rem .8rem;
    border-radius: .55rem;
    background: #edf7f4;
    color: #0d7267;
    font-size: clamp(1rem, 2.1vw, 1.35rem);
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: -.025em;
  }
  .hero-topics > span { grid-area: 1 / 1; }
  .hero-topic-size { visibility: hidden; padding-inline-end: .45rem; }
  .hero-caret { display: none; width: .095em; height: .78em; margin-inline-start: .16em; background: currentColor; }
  .is-typing .hero-caret { display: inline-block; }
  .hero-description { max-width: 58ch; margin: 1rem auto 0; color: #445673; font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.65; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; margin-top: 1.65rem; }
  .home-section { padding-block: clamp(3.5rem, 6.2vw, 6.25rem); }
  .section-intro { margin: 0 auto 2rem; max-width: 48rem; text-align: center; }
  .home-heading { font-family: var(--font-heading, inherit); font-size: clamp(1.8rem, 3.25vw, 3.15rem); font-weight: 780; line-height: 1.12; letter-spacing: -.038em; text-wrap: balance; }
  .home-description { margin-top: .75rem; color: #445673; line-height: 1.7; }
  .home-card { background: linear-gradient(145deg, var(--tile-tint, white), white 85%); }
  .industry-photo { width: 100%; aspect-ratio: 1.65; height: auto; object-fit: cover; border-radius: 1.4rem; background: #e5efec; }
  .control-card { border: 1px solid #dae6e9; border-radius: 1rem; background: #f8fbfc; padding: 1.35rem; }
  .demo-banner { background: radial-gradient(ellipse at 94% 0%, #22645e, transparent 55%), #152a49; }
  @media (max-width: 390px) {
    .hero-actions > :global(a) { width: 100%; }
  }
</style>
