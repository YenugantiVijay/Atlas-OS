---
import { ArrowRight, Banknote, Boxes, Calculator, ChartNoAxesColumnIncreasing, ChevronDown, FileText, ListChecks, PackageCheck, Receipt, ShoppingCart, Store, TrendingUp } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Container from '../components/common/Container.astro';
import IndustryLinks from '../components/common/IndustryLinks.astro';
import InteractivePreview from '../components/home/InteractivePreview';
import { PRICING_TIERS } from '../data/pricing';

const features = [
  { title: 'Keep Track of Your Stock', text: 'Record deliveries and check what is available before you promise it to a customer.', href: '/features#inventory', Icon: Boxes, color: '#0f766e', tint: '#edf8f5' },
  { title: 'Manage Customer Orders', text: 'Find products, prepare a quotation, and follow the order from confirmation to billing.', href: '/features', Icon: ShoppingCart, color: '#1d4ed8', tint: '#eff5fc' },
  { title: 'Handle Your Invoices', text: 'Create GST invoices with the customer, item, and tax details in one place.', href: '/features#invoicing', Icon: FileText, color: '#7c3aed', tint: '#f5f1fb' },
  { title: 'Track Customer Payments', text: 'Record a payment, print a receipt, and see which invoices still have a balance.', href: '/features#payments', Icon: Banknote, color: '#a16207', tint: '#fff7ed' },
  { title: 'Understand Your Business', text: 'Review sales and customer dues, then export the reports you need to share.', href: '/features#reports', Icon: ChartNoAxesColumnIncreasing, color: '#0369a1', tint: '#edf7fa' },
];
const starter = PRICING_TIERS.find(plan => plan.id === 'starter')!;
const faqs = [
  ['What is Atlas OS?', 'It’s a workspace for shops, wholesalers, and distributors. You can receive stock, prepare orders, create invoices, and record payments from the same workspace.'],
  ['Can I start with one shop?', 'Yes. Atlas Starter covers the everyday stock, sales, and collections workflow, including a branded customer receipt.'],
  ['What happens when a supplier changes a price?', 'Atlas Professional includes supplier price history and a review queue for affected quotes. Your team decides which quotes need updating.'],
  ['How can I try it?', 'Use the interactive preview on this page, or request a guided demo and bring a sample sale or stock delivery to walk through.'],
];
---

<BaseLayout title="Atlas OS | Stock, billing and payments for shops and distributors"
  description="Manage stock, sales, billing, and customer payments in one Atlas OS workspace for shops and distributors.">
  <section id="home-overview" class="hero-shell border-b border-border">
    <Container size="wide" class="grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.04fr)_minmax(0,.96fr)] lg:gap-12 lg:py-20">
      <div class="min-w-0 space-y-5">
        <p class="text-sm font-semibold text-content-secondary" data-enter>For shops, wholesalers, and distributors</p>
        <h1 class="max-w-[16ch] font-heading text-4xl font-extrabold leading-[1.11] tracking-tight sm:text-5xl xl:text-6xl" data-enter>
          Stock, billing, and payments <span class="text-brand-700">in one place.</span>
        </h1>
        <p class="max-w-[48ch] text-base leading-relaxed text-content-secondary sm:text-lg" data-enter data-delay="1">Know what’s in stock, turn orders into invoices, and see who still owes you. Atlas OS keeps the details connected as your team works.</p>
        <div class="flex flex-wrap gap-3 pt-1" data-enter data-delay="2">
          <Button href="/request-demo" variant="primary" size="lg">Request a Demo <ArrowRight size={18} aria-hidden="true" /></Button>
          <Button href="/product" variant="outline" size="lg">Explore Atlas OS</Button>
        </div>
      </div>
      <div class="min-w-0 rounded-3xl border border-brand-200 bg-white p-4 shadow-lg sm:p-6" data-enter data-delay="1">
        <div class="flex items-center justify-between gap-2 border-b border-border pb-4">
          <div class="flex items-center gap-2.5 font-heading text-base font-bold"><Store size={20} className="shrink-0 text-brand-700" aria-hidden="true" /> Today at the counter</div>
          <span class="shrink-0 text-xs text-content-secondary">Example</span>
        </div>
        <ul class="divide-y divide-border">
          {[
            { Icon: PackageCheck, label: 'Stock received', text: '24 boxes of switches added', value: '+24 boxes' },
            { Icon: Receipt, label: 'Invoice issued', text: 'An electrical contractor’s order', value: '₹5,900' },
            { Icon: Banknote, label: 'Payment recorded', text: 'UPI payment applied to the invoice', value: '₹5,900' },
          ].map(({ Icon, label, text, value }) => <li class="flex flex-wrap items-center gap-3 py-4">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700"><Icon size={20} aria-hidden="true" /></span>
            <div class="min-w-0 flex-1"><p class="text-sm font-bold">{label}</p><p class="mt-0.5 text-xs leading-relaxed text-content-secondary">{text}</p></div>
            <span class="text-sm font-bold tabular-nums text-brand-800">{value}</span>
          </li>)}
        </ul>
        <div class="flex items-center justify-between gap-2 rounded-xl bg-surface-secondary px-3 py-3 text-sm"><span class="font-semibold">Balance on this invoice</span><strong>₹0</strong></div>
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16" id="daily-workflow">
    <Container size="wide">
      <div class="mb-6 max-w-3xl" data-reveal>
        <h2 class="home-heading">One Place for Your Daily Business</h2>
        <p class="home-description">Follow a sale from the stockroom to the receipt, with each step connected.</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5" data-reveal-group>
        {features.map(({ title, text, href, Icon, color, tint }) => <li>
          <a href={href} style={`--icon-accent:${color};--tile-tint:${tint}`} class="home-card atlas-icon-card flex h-full flex-col items-start gap-3 rounded-2xl border border-border p-5">
            <span class="atlas-card-icon grid h-11 w-11 place-items-center rounded-xl"><Icon size={22} aria-hidden="true" /></span>
            <div><h3 class="font-heading text-base font-bold">{title}</h3><p class="mt-2 text-sm leading-relaxed text-content-secondary">{text}</p></div>
            <ArrowRight size={18} className="mt-auto text-brand-700" aria-hidden="true" />
          </a>
        </li>)}
      </ul>
    </Container>
  </section>

  <section class="border-y border-border bg-surface-secondary py-12 sm:py-16">
    <Container size="wide" class="grid items-center gap-7 lg:grid-cols-[.92fr_1.08fr]">
      <div data-reveal>
        <h2 class="home-heading">When a supplier rate changes, see which quotes need review.</h2>
        <p class="home-description">Atlas OS keeps a history of supplier prices and flags open quotes that use the affected products. Your team chooses what to update before sending the quote.</p>
        <a href="/features#supplier-rate-review" class="mt-4 inline-flex items-center gap-2 font-semibold text-brand-700 hover:underline">See supplier price review <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
      <div class="rounded-3xl border border-brand-200 bg-white p-5 sm:p-7" data-reveal>
        <p class="mb-4 flex items-center gap-2 font-heading text-lg font-bold"><TrendingUp size={22} className="text-brand-700" aria-hidden="true" /> Example supplier update</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl bg-surface-secondary p-4"><p class="text-sm text-content-secondary">Previous cost per box</p><p class="mt-1 text-2xl font-bold">₹800</p></div>
          <div class="rounded-xl bg-brand-50 p-4"><p class="text-sm text-brand-800">New cost per box</p><p class="mt-1 text-2xl font-bold text-brand-800">₹850</p></div>
        </div>
        <p class="mt-4 flex items-start gap-2 text-sm font-semibold"><ListChecks size={18} className="shrink-0 text-brand-700" aria-hidden="true" /> Review the open quote before you send it.</p>
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container size="wide">
      <div class="mb-6" data-reveal>
        <h2 class="home-heading">Connected Business Workflow</h2>
        <p class="home-description">Try the sample workspace. Switch between stock, invoicing, payments, and reports.</p>
      </div>
      <InteractivePreview client:load />
    </Container>
  </section>

  <section class="border-y border-border bg-surface-secondary py-12 sm:py-16">
    <Container size="wide">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div><h2 class="home-heading">Find your industry</h2><p class="home-description">See the tools in the context of your day-to-day work.</p></div>
        <Button href="/solutions/" variant="outline">All industries <ArrowRight size={17} aria-hidden="true" /></Button>
      </div>
      <div data-reveal><IndustryLinks /></div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container size="wide">
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-brand-200 bg-gradient-to-r from-brand-50 to-white p-6 sm:p-9" data-reveal>
        <div><h2 class="home-heading">A plan for the way you work</h2><p class="home-description">Atlas Starter starts at {starter.priceDisplay}{starter.billingPeriod.replace(' ', '')}. Compare plans for your shop, counter, or distribution team.</p></div>
        <Button href="/pricing" variant="primary">Compare plans <ArrowRight size={17} aria-hidden="true" /></Button>
      </div>
    </Container>
  </section>

  <section class="pb-12 sm:pb-16">
    <Container size="wide">
      <div class="mb-6" data-reveal><h2 class="home-heading">Free tools and guides</h2><p class="home-description">Calculate GST, preview a receipt, or get help with a workflow.</p></div>
      <ul class="grid gap-4 sm:grid-cols-3" data-reveal-group>
        {[
          { name: 'Atlas Calculators', text: 'GST, margin, EMI, inventory and more.', href: '/calculators/', Icon: Calculator, tint: '#edf8f5' },
          { name: 'Receipt templates', text: 'Preview a receipt with your own branding.', href: '/receipt-templates', Icon: Receipt, tint: '#f5f1fb' },
          { name: 'Help and guides', text: 'Find answers about setup, features and everyday work.', href: '/resources/', Icon: ListChecks, tint: '#eff5fc' },
        ].map(({ name, text, href, Icon, tint }) => <li><a class="home-card atlas-icon-card flex h-full gap-3 rounded-2xl border border-border p-5" style={`--tile-tint:${tint}`} href={href}>
          <span class="atlas-card-icon grid h-10 w-10 shrink-0 place-items-center rounded-lg"><Icon size={20} aria-hidden="true" /></span>
          <div><h3 class="font-heading text-lg font-bold">{name}</h3><p class="mt-1 text-sm leading-relaxed text-content-secondary">{text}</p></div>
        </a></li>)}
      </ul>
    </Container>
  </section>

  <section class="border-y border-border bg-surface-secondary py-12 sm:py-16">
    <Container size="narrow">
      <h2 class="home-heading mb-5" data-reveal>Frequently asked questions</h2>
      <div class="grid gap-3" data-reveal-group>
        {faqs.map(([question, answer]) => <details class="group rounded-2xl border border-border bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-semibold">{question}<ChevronDown size={18} className="shrink-0 text-brand-700 group-open:rotate-180" aria-hidden="true" /></summary>
          <p class="px-4 pb-4 text-sm leading-relaxed text-content-secondary">{answer}</p>
        </details>)}
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container size="wide">
      <div class="flex flex-wrap items-center justify-between gap-5 rounded-3xl bg-navy-900 p-6 text-white sm:p-9" data-reveal>
        <div class="max-w-2xl"><h2 class="home-heading">See Atlas OS with your workflow</h2><p class="mt-2 leading-relaxed text-slate-200">Bring a sample invoice, order, or stock delivery to the walkthrough.</p></div>
        <div class="flex flex-wrap gap-3"><Button href="/request-demo" variant="white" size="lg">Request a Demo</Button><Button href="/product" variant="primary" size="lg">Explore Atlas OS</Button></div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .hero-shell { background: radial-gradient(ellipse at 85% 20%, #def5ef, transparent 48%), #f6f9fb; }
  .home-heading { font-family: var(--font-heading, inherit); font-size: clamp(1.65rem, 3vw, 2.5rem); font-weight: 750; line-height: 1.18; letter-spacing: -.03em; }
  .home-description { margin-top: .65rem; color: #445673; line-height: 1.65; }
  .home-card { background: linear-gradient(145deg, var(--tile-tint, white), white 85%); }
</style>
