---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import Badge from '../components/common/Badge.astro';
import InteractivePreview from '../components/home/InteractivePreview';
import { INDUSTRY_SOLUTIONS } from '../data/industries';
import { ALL_FEATURES } from '../data/features';
---

<BaseLayout
  title="Atlas OS — The AI-Native Business Operating System for Distributors"
  description="Manage multi-brand inventory, sales orders, statutory GST invoices, customer credit limits, and payment allocations from one connected workspace. Built for electrical, electronics, and hardware distributors."
>
  {/* HERO SECTION */}
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden bg-radial-glow border-b border-border/50">
    <Container size="default">
      <div class="flex flex-col items-center text-center space-y-6 max-w-4xl mx-auto">
        <!-- Top Announcement Badge -->
        <div class="animate-fade-in">
          <Badge variant="violet" size="md" class="gap-1.5 py-1 px-3.5">
            <span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse"></span>
            <span>AI-Native Business Operating System for Distributors</span>
          </Badge>
        </div>

        <!-- Hero Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold font-display tracking-tight text-content-primary leading-[1.12] animate-fade-up">
          Your Business. One <span class="text-gradient">Intelligent</span> Operating System.
        </h1>

        <!-- Hero Subhead -->
        <p class="text-base sm:text-lg md:text-xl text-content-secondary leading-relaxed max-w-3xl animate-fade-up font-normal">
          Manage multi-brand inventory, sales orders, statutory GST tax invoices, customer receivables ledgers, and
          multi-invoice payment allocations from one connected, high-speed workspace. Engineered specifically for
          modern electrical, electronics, and hardware businesses.
        </p>

        <!-- Call to Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3.5 pt-2 animate-fade-up">
          <Button href="/request-demo" variant="primary" size="lg" class="shadow-glow">
            <span>Request a Demo</span>
            <svg class="w-4 h-4 ml-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href="/product" variant="outline" size="lg">
            <span>Explore Atlas OS</span>
          </Button>

          <Button href="/download" variant="secondary" size="lg" class="gap-2">
            <svg class="w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Windows Desktop (Preview)</span>
          </Button>
        </div>

        <!-- Social Proof Micro-Bar -->
        <div class="pt-6 flex flex-wrap items-center justify-center gap-6 text-xs text-content-secondary font-medium border-t border-border/40 w-full">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>Statutory Indian GST Compliant</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>Multi-UOM Physical Packaging</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>1-Click 15-Year Excel Exports</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>PostgreSQL Row Level Security</span>
          </div>
        </div>
      </div>

      <!-- INTERACTIVE PRODUCT PREVIEW -->
      <div class="mt-12 md:mt-16 max-w-6xl mx-auto">
        <InteractivePreview client:load />
      </div>
    </Container>
  </section>

  {/* SECTION 2: VALUE PROPOSITIONS */}
  <section class="py-20 bg-surface-secondary border-b border-border">
    <Container size="default">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-14">
        <Badge variant="violet" size="sm">Operational Architecture</Badge>
        <h2 class="text-3xl font-extrabold font-display text-content-primary">
          Engineered for Real-World Wholesale Velocity
        </h2>
        <p class="text-sm text-content-secondary leading-relaxed">
          Legacy software burdens electrical and hardware distributors with fragile local files, awkward hotkeys,
          and slow screen updates. Atlas OS delivers instantaneous modern clarity without sacrificing financial rigor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl border border-border bg-white shadow-card hover:shadow-card-hover transition-all duration-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold">
            01
          </div>
          <h3 class="text-base font-bold font-display text-content-primary">Zero Redundant Queries</h3>
          <p class="text-xs text-content-secondary leading-relaxed">
            High-speed, page-scoped database aggregations ensure live sales, dues, and stock valuations load
            instantaneously even when managing tens of thousands of customer invoices.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-white shadow-card hover:shadow-card-hover transition-all duration-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold">
            02
          </div>
          <h3 class="text-base font-bold font-display text-content-primary">Contractor Credit Protection</h3>
          <p class="text-xs text-content-secondary leading-relaxed">
            Automatic credit limit verification prevents unauthorized dispatch to over-limit accounts before sales orders
            can be confirmed into delivery challans.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-white shadow-card hover:shadow-card-hover transition-all duration-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold">
            03
          </div>
          <h3 class="text-base font-bold font-display text-content-primary">Statutory Excel Engine</h3>
          <p class="text-xs text-content-secondary leading-relaxed">
            One-click audit-ready Microsoft Excel workbooks for any Indian Financial Year (April 1 to March 31) with
            immutable GST snapshots and revenue segregation.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-white shadow-card hover:shadow-card-hover transition-all duration-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold">
            04
          </div>
          <h3 class="text-base font-bold font-display text-content-primary">Multi-Tenant Isolation</h3>
          <p class="text-xs text-content-secondary leading-relaxed">
            Bank-grade PostgreSQL Row Level Security (RLS) guaranteeing that separate branches, warehouses, or partner firms
            maintain 100% cryptographic data segregation.
          </p>
        </div>
      </div>
    </Container>
  </section>

  {/* SECTION 3: CORE CAPABILITIES DIRECTORY */}
  <section class="py-20 bg-white border-b border-border">
    <Container size="default">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="space-y-2 max-w-2xl">
          <Badge variant="violet" size="sm">Core Product Modules</Badge>
          <h2 class="text-3xl font-extrabold font-display text-content-primary">
            Connected Business Modules. No Siloed Spreadsheets.
          </h2>
          <p class="text-sm text-content-secondary leading-relaxed">
            Every transaction automatically reconciles across stock availability, customer ledgers, commercial invoices,
            and executive reports.
          </p>
        </div>

        <Button href="/features" variant="outline" size="md">
          <span>View All Features</span>
          <svg class="w-4 h-4 ml-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ALL_FEATURES.slice(0, 6).map((feat) => (
          <div class="p-6 rounded-2xl border border-border bg-surface-secondary/40 hover:bg-white hover:border-brand-300 transition-all duration-200 space-y-4 shadow-card hover:shadow-card-hover flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-brand-50 text-brand-700 border border-brand-200">
                  {feat.statusLabel}
                </span>
                {feat.metrics && <span class="text-[11px] text-content-muted font-mono">{feat.metrics}</span>}
              </div>

              <h3 class="text-lg font-bold font-display text-content-primary">{feat.title}</h3>
              <p class="text-xs text-content-secondary leading-relaxed">{feat.description}</p>
            </div>

            <ul class="space-y-1.5 pt-2 border-t border-border/50 text-xs">
              {feat.highlights.slice(0, 3).map((hl) => (
                <li class="flex items-start gap-2 text-content-primary">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-600 mt-1.5 shrink-0"></span>
                  <span>{hl}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* SECTION 4: INDUSTRY SPOTLIGHT */}
  <section class="py-20 bg-surface-secondary border-b border-border">
    <Container size="default">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-14">
        <Badge variant="violet" size="sm">Targeted Distribution</Badge>
        <h2 class="text-3xl font-extrabold font-display text-content-primary">
          Built For Real Distribution Workflows
        </h2>
        <p class="text-sm text-content-secondary leading-relaxed">
          From coil packaging conversions to multi-month contractor credit ledgers, Atlas OS is architected around the
          daily operational realities of trade distribution.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {INDUSTRY_SOLUTIONS.map((sol) => (
          <div class="p-6 sm:p-8 rounded-3xl border border-border bg-white shadow-md hover:shadow-lg transition-all duration-200 space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-700 border border-brand-200">
                  {sol.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold font-display text-content-primary">{sol.title}</h3>
              <p class="text-xs text-brand-700 font-semibold">{sol.tagline}</p>
              <p class="text-xs text-content-secondary leading-relaxed">{sol.description}</p>

              <div class="space-y-2 pt-2 border-t border-border/60">
                <p class="text-xs font-bold uppercase tracking-wider text-content-primary font-display">
                  Key Solved Challenges:
                </p>
                <ul class="space-y-1.5 text-xs">
                  {sol.howAtlasSolves.slice(0, 3).map((soln) => (
                    <li class="flex items-start gap-2 text-content-primary">
                      <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                      <span>{soln}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-border/50">
              <a
                href={`/solutions#${sol.id}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-700 hover:text-brand-800"
              >
                <span>Read Full Industry Workflow</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* SECTION 5: FINAL CTA BANNER */}
  <section class="py-20 bg-surface-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-glow-dark opacity-60 pointer-events-none"></div>
    <Container size="default">
      <div class="relative z-10 flex flex-col items-center text-center space-y-6 max-w-3xl mx-auto">
        <Badge variant="violet" size="sm" class="bg-brand-500/20 text-brand-300 border-brand-500/30">
          Ready to Modernize Your Wholesale Workflows?
        </Badge>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display tracking-tight text-white leading-tight">
          Bring Your Inventory, Orders & Financials Into One Intelligent System.
        </h2>

        <p class="text-sm sm:text-base text-content-muted leading-relaxed max-w-2xl">
          Schedule a personalized demonstration with our technical solutions team to explore how Atlas OS can
          streamline your specific product catalog and billing operations.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <Button href="/request-demo" variant="primary" size="lg" class="shadow-glow">
            <span>Request a Guided Demo</span>
            <svg class="w-4 h-4 ml-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href="/download" variant="outline" size="lg" class="bg-white/10 hover:bg-white/20 text-white border-white/20">
            <span>Download Desktop App Preview</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
