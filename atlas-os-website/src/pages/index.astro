              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </Button>

          <Button href="/download" variant="outline" size="lg" class="bg-brand-800/40 hover:bg-brand-800/60 text-white border-white/30 font-semibold">
