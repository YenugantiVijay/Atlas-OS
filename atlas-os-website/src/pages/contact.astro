---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Badge from '../components/common/Badge.astro';
import Button from '../components/common/Button.astro';
import ContactForm from '../components/contact/ContactForm';
import { 
  Phone, 
  Clock, 
  ShieldCheck, 
  MessageSquare, 
  Sparkles, 
  ArrowRight, 
  Headphones 
} from 'lucide-react';
---

<BaseLayout 
  title="Contact Sales, Support & Engineering Desk | Atlas OS"
  description="Get in touch with the Atlas OS team for sales enquiries, personalized demonstrations, technical support, data migration assistance, and security questions."
  canonicalUrl="https://atlas-os.web.app/contact"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-brand-50/60 via-surface to-surface relative overflow-hidden border-b border-border-subtle">
    <div class="absolute inset-0 bg-grid-pattern opacity-60 pointer-events-none"></div>
    <div class="absolute -top-24 right-1/4 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <Badge variant="brand" className="mb-4">
          <MessageSquare className="w-3.5 h-3.5 mr-1.5" />
          Direct Communication Desk
        </Badge>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-text-primary tracking-tight font-display mb-6">
          Connect with the <span class="bg-gradient-to-r from-brand-600 to-brand-800 bg-clip-text text-transparent">Atlas OS team</span>.
        </h1>
        <p class="text-lg sm:text-xl text-text-secondary leading-relaxed">
          Whether you are evaluating Atlas OS for your distribution network, need technical assistance, or want to discuss data migration from legacy accounting systems, we are ready to assist.
        </p>
      </div>
    </Container>
  </section>

  <!-- Contact Channels & Form Grid -->
  <section class="py-16 sm:py-24 bg-surface">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Department Channels & Office Details -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl sm:text-3xl font-black text-text-primary font-display mb-3">
              Reach the Right Department
            </h2>
            <p class="text-text-secondary text-sm leading-relaxed mb-6">
              Our engineering and client advisory teams respond quickly across dedicated channels during trade hours.
            </p>
          </div>

          <!-- Channel Cards -->
          <div class="space-y-4">
            <!-- Sales -->
            <div class="p-5 rounded-2xl bg-white border border-border-subtle shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
                <Sparkles className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold text-text-primary text-sm">Product Sales & Licensing</h3>
                <p class="text-xs text-text-secondary mt-0.5 mb-2">New accounts, multi-branch licensing & volume pricing</p>
                <a href="mailto:sales@atlas-os.web.app" class="text-xs font-semibold text-brand-600 hover:underline">sales@atlas-os.web.app</a>
              </div>
            </div>

            <!-- Support -->
            <div class="p-5 rounded-2xl bg-white border border-border-subtle shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <Headphones className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold text-text-primary text-sm">Technical Support & Helpdesk</h3>
                <p class="text-xs text-text-secondary mt-0.5 mb-2">Billing assistance, barcode scanning & hardware setup</p>
                <a href="mailto:support@atlas-os.web.app" class="text-xs font-semibold text-emerald-600 hover:underline">support@atlas-os.web.app</a>
              </div>
            </div>

            <!-- Security -->
            <div class="p-5 rounded-2xl bg-white border border-border-subtle shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-violet-50 text-brand-600 flex items-center justify-center shrink-0">
                <ShieldCheck className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold text-text-primary text-sm">Security & Privacy Governance</h3>
                <p class="text-xs text-text-secondary mt-0.5 mb-2">Vulnerability reports, data compliance & audit trails</p>
                <a href="mailto:security@atlas-os.web.app" class="text-xs font-semibold text-brand-600 hover:underline">security@atlas-os.web.app</a>
              </div>
            </div>
          </div>

          <!-- Operating Hours & Base -->
          <div class="p-6 rounded-2xl bg-white border border-border-subtle shadow-sm space-y-4">
            <div class="flex items-start gap-3">
              <Clock className="w-5 h-5 text-brand-600 shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-text-primary">Operational Hours</h4>
                <p class="text-sm text-text-secondary mt-1">
                  Monday – Saturday: 9:00 AM – 8:00 PM IST<br />
                  Sunday: Closed (Emergency Escalation Only)
                </p>
              </div>
            </div>
            <div class="pt-3 border-t border-border-subtle flex items-start gap-3">
              <Phone className="w-5 h-5 text-brand-600 shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-text-primary">Direct Phone Support</h4>
                <p class="text-sm text-text-secondary mt-1">
                  <a href="tel:+918000000000" class="hover:text-brand-600 transition-colors">+91 (800) 000-0000</a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-8 sm:p-10 border border-border-subtle shadow-xl shadow-brand-500/5">
            <div class="mb-6">
              <h3 class="text-2xl font-black text-text-primary font-display">Send a Direct Message</h3>
              <p class="text-sm text-text-secondary mt-1">
                Fill out the form below and our designated team will get back to you promptly.
              </p>
            </div>

            <!-- React Contact Form -->
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Quick Demo Banner -->
  <section class="py-16 bg-white border-t border-border-subtle">
    <Container>
      <div class="bg-gradient-to-r from-brand-900 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-2xl font-bold font-display mb-2">Looking for a live software walkthrough?</h3>
          <p class="text-slate-300 text-sm max-w-xl">
            Book a dedicated 30-minute demonstration with our product architects to see how Atlas OS handles your exact product catalog and trade counter.
          </p>
        </div>
        <Button href="/request-demo" variant="primary" size="lg" className="shrink-0 bg-white text-slate-900 hover:bg-slate-100">
          Book Live Walkthrough
          <ArrowRight className="w-4 h-4 ml-2" />
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
