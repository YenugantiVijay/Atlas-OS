---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import ContactForm from '../components/contact/ContactForm';
import { 
  Phone, 
  Clock, 
  ShieldCheck, 
  MessageSquare, 
  Sparkles, 
  ArrowRight, 
  Headphones 
} from 'lucide-react';
---

<BaseLayout 
  title="Contact Sales, Support & Engineering Desk | Atlas OS"
  description="Get in touch with the Atlas OS team for sales enquiries, personalized demonstrations, technical support, data migration assistance, and security questions."
  canonicalUrl="https://atlasos.business/contact"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50 relative overflow-hidden">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          <MessageSquare className="w-3.5 h-3.5 mr-1 text-brand-700" />
          Direct Communication Desk
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-content-primary tracking-tight font-heading leading-tight">
          Connect with the <span class="text-gradient">Atlas OS team</span>.
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Whether you are evaluating Atlas OS for your distribution network, need technical assistance, or want to discuss data migration from legacy accounting systems, we are ready to assist.
        </p>
      </div>
    </Container>
  </section>

  <!-- Contact Channels & Form Grid -->
  <section class="py-16 sm:py-24 bg-surface-secondary/40">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Department Channels & Office Details -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-content-primary font-heading mb-3">
              Reach the Right Department
            </h2>
            <p class="text-content-secondary text-sm leading-relaxed mb-6">
              Our engineering and client advisory teams respond quickly across dedicated channels during trade hours.
            </p>
          </div>

          <!-- Channel Cards -->
          <div class="space-y-4">
            <!-- Sales -->
            <div class="p-5 rounded-2xl bg-white border border-border shadow-2xs flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0">
                <Sparkles className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary text-sm">Product Sales & Licensing</h3>
                <p class="text-xs text-content-secondary mt-0.5 mb-2">New accounts, multi-branch licensing & volume pricing</p>
                <a href="mailto:sales@atlasos.business" class="text-xs font-semibold text-brand-700 hover:underline">sales@atlasos.business</a>
              </div>
            </div>

            <!-- Support -->
            <div class="p-5 rounded-2xl bg-white border border-border shadow-2xs flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
                <Headphones className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary text-sm">Technical Support & Helpdesk</h3>
                <p class="text-xs text-content-secondary mt-0.5 mb-2">Billing assistance, barcode scanning & hardware setup</p>
                <a href="mailto:support@atlasos.business" class="text-xs font-semibold text-emerald-700 hover:underline">support@atlasos.business</a>
              </div>
            </div>

            <!-- Security -->
            <div class="p-5 rounded-2xl bg-white border border-border shadow-2xs flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-navy-50 text-navy-700 flex items-center justify-center shrink-0">
                <ShieldCheck className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary text-sm">Security & Privacy Governance</h3>
                <p class="text-xs text-content-secondary mt-0.5 mb-2">Vulnerability reports, data compliance & audit trails</p>
                <a href="mailto:security@atlasos.business" class="text-xs font-semibold text-brand-700 hover:underline">security@atlasos.business</a>
              </div>
            </div>
          </div>

          <!-- Operating Hours & Base -->
          <div class="p-6 rounded-2xl bg-white border border-border shadow-2xs space-y-4">
            <div class="flex items-start gap-3">
              <Clock className="w-5 h-5 text-brand-600 shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary font-heading">Operational Hours</h4>
                <p class="text-xs sm:text-sm text-content-secondary mt-1">
                  Monday – Saturday: 9:00 AM – 8:00 PM IST<br />
                  Sunday: Closed (Emergency Escalation Only)
                </p>
              </div>
            </div>
            <div class="pt-3 border-t border-border flex items-start gap-3">
              <Phone className="w-5 h-5 text-brand-600 shrink-0 mt-0.5" />
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-content-primary font-heading">Direct Phone Support</h4>
                <p class="text-xs sm:text-sm text-content-secondary mt-1">
                  <a href="tel:+918000000000" class="hover:text-brand-700 transition-colors font-medium">+91 (800) 000-0000</a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-8 sm:p-10 border border-border shadow-md">
            <div class="mb-6 space-y-1">
              <h3 class="text-2xl font-bold text-content-primary font-heading">Send a Direct Message</h3>
              <p class="text-sm text-content-secondary">
                Fill out the form below and our designated team will get back to you promptly.
              </p>
            </div>

            <!-- React Contact Form -->
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Quick Demo Banner -->
  <section class="py-16 bg-white border-t border-border">
    <Container>
      <div class="bg-surface-dark rounded-3xl p-8 sm:p-12 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-brand-500/20">
        <div>
          <h3 class="text-2xl font-bold font-heading mb-2">Looking for a live software walkthrough?</h3>
          <p class="text-content-muted text-sm max-w-xl">
            Book a dedicated 30-minute demonstration with our product architects to see how Atlas OS handles your exact product catalog and trade counter.
          </p>
        </div>
        <Button href="/request-demo" variant="primary" size="lg" class="shrink-0 bg-white text-navy-900 hover:bg-brand-50 font-bold">
          <span>Book Live Walkthrough</span>
          <ArrowRight className="w-4 h-4 ml-2" />
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
