---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import RequestDemoForm from '../components/demo/RequestDemoForm';
import { Boxes, ClipboardList, IndianRupee } from 'lucide-react';

const topics = [
  { icon: Boxes, title: 'Stock and purchasing', detail: 'Find items, compare supplier rates, and track incoming deliveries.' },
  { icon: ClipboardList, title: 'Sales and billing', detail: 'Follow a quote or sales order through to an invoice.' },
  { icon: IndianRupee, title: 'Collections and receipts', detail: 'Record a payment, print a receipt, and review daily totals.' },
];
---

<BaseLayout title="Request a Personalized Live Demo | Atlas OS"
  description="Request a walkthrough of Atlas OS for your shop, wholesale business, or distribution team.">
  <section class="bg-radial-glow py-8 sm:py-12 lg:py-16">
    <Container>
      <div class="mx-auto grid max-w-6xl items-start gap-7 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] lg:gap-12">
        <div class="min-w-0 space-y-6 lg:py-5" data-enter>
          <div>
            <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
              See Atlas OS with <span class="text-gradient">your workflow.</span>
            </h1>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-content-secondary sm:text-base">Tell us how you work. We’ll tailor the walkthrough to the tools you use every day.</p>
          </div>
          <div class="space-y-3 border-t border-border pt-4">
            <h2 class="text-base font-bold">What we can walk through</h2>
            <ul class="space-y-3">
              {topics.map(({ icon: Icon, title, detail }) => (
                <li class="flex gap-3">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700"><Icon size={16} aria-hidden="true" /></span>
                  <div><h3 class="text-sm font-semibold">{title}</h3><p class="mt-0.5 text-xs leading-relaxed text-content-secondary">{detail}</p></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="min-w-0" data-enter data-delay="1"><RequestDemoForm client:load /></div>
      </div>
    </Container>
  </section>
</BaseLayout>
