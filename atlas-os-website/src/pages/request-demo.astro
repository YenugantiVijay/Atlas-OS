---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import RequestDemoForm from '../components/demo/RequestDemoForm';
import { 
  CheckCircle2, 
  Calendar, 
  ShieldCheck 
} from 'lucide-react';
---

<BaseLayout 
  title="Request a Personalized Live Demo | Atlas OS"
  description="Book a 30-minute tailored walkthrough of Atlas OS with our product architects. See how Atlas OS manages your exact electrical, electronics, or hardware wholesale operations."
  canonicalUrl="https://atlas-os.web.app/request-demo"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-radial-glow border-b border-border/50 relative overflow-hidden">
    <Container>
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 text-brand-800 border border-brand-200">
          <Calendar className="w-3.5 h-3.5 mr-1 text-brand-700" />
          Live 1-on-1 Product Walkthrough
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-content-primary tracking-tight font-heading leading-tight">
          See Atlas OS in action on <span class="text-gradient">your business terms</span>.
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Book a focused 30-minute demonstration tailored specifically to your trade — electrical distribution, electronics wholesale, or retail-wholesale counters. No high-pressure sales pitch.
        </p>
      </div>
    </Container>
  </section>

  <!-- Main Content & Form Grid -->
  <section class="py-16 sm:py-24 bg-surface-secondary/40">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: What to Expect & Value Props -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-content-primary font-heading mb-4">
              What happens during the demo?
            </h2>
            <p class="text-sm sm:text-base text-content-secondary leading-relaxed mb-6">
              Our engineering specialists walk you through a live, working environment pre-populated with realistic hardware & distribution data, or customized to sample items you share.
            </p>
          </div>

          <!-- Feature Breakdown Steps -->
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-border shadow-2xs hover:border-brand-200 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0 font-bold font-heading">
                1
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary mb-1 text-sm">Workflow Diagnostic</h3>
                <p class="text-xs text-content-secondary leading-relaxed">
                  We review your current billing speed bottlenecks, multi-rate GST complexities, ledger reconciliation pain points, or stock discrepancy challenges.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-border shadow-2xs hover:border-brand-200 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0 font-bold font-heading">
                2
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary mb-1 text-sm">Live Product Simulation</h3>
                <p class="text-xs text-content-secondary leading-relaxed">
                  Watch multi-UOM inventory conversion (boxes to meters), rapid counter POS keyboard entry, customer credit limit enforcement, and instantaneous invoice generation.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-border shadow-2xs hover:border-brand-200 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0 font-bold font-heading">
                3
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary mb-1 text-sm">Financial Reconciliation Walkthrough</h3>
                <p class="text-xs text-content-secondary leading-relaxed">
                  See how partial customer receipts allocate accurately across oldest pending invoices with automated unapplied balance tracking and one-click Excel audit exports.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-border shadow-2xs hover:border-brand-200 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center shrink-0 font-bold font-heading">
                4
              </div>
              <div>
                <h3 class="font-bold font-heading text-content-primary mb-1 text-sm">Clear Q&A & Migration Assessment</h3>
                <p class="text-xs text-content-secondary leading-relaxed">
                  Ask every technical, hardware compatibility, and data migration question directly. We provide a transparent assessment of fit and timeline.
                </p>
              </div>
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="p-6 rounded-2xl bg-surface-dark text-white space-y-4 border border-brand-500/20 shadow-sm">
            <div class="flex items-center gap-2 text-brand-300 font-bold text-sm font-heading">
              <ShieldCheck className="w-5 h-5 text-emerald-400" />
              <span>Atlas OS Demonstration Guarantee</span>
            </div>
            <ul class="text-xs text-slate-300 space-y-2">
              <li class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Zero obligation, no persistent spam calls, strictly professional conduct.</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Demonstration conducted by technical specialists who understand ERP workflows.</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Direct access to a live interactive sandbox environment following the session.</span>
              </li>
            </ul>
          </div>

          <!-- Quick Contact -->
          <div class="pt-4 border-t border-border">
            <p class="text-xs text-content-secondary">
              Prefer an immediate conversation? Reach our sales engineering desk directly at <a href="mailto:demo@atlasos.business" class="text-brand-700 font-semibold hover:underline">demo@atlasos.business</a>.
            </p>
          </div>
        </div>

        <!-- Right Column: Interactive Demo Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-8 sm:p-10 border border-border shadow-md relative">
            <div class="mb-8 space-y-1">
              <h3 class="text-2xl font-bold text-content-primary font-heading">Schedule Your Walkthrough</h3>
              <p class="text-sm text-content-secondary">
                Fill in your details below and our team will confirm your preferred session time within 4 business hours.
              </p>
            </div>

            <!-- React Form Component -->
            <RequestDemoForm client:load />
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
