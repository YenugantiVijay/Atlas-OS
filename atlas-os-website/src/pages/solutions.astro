---
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import { INDUSTRY_SOLUTIONS } from '../data/industries';
import { INDUSTRY_COLORS } from '../data/industry-colors';
import { industryDownloadHref } from '../data/industry-downloads';
---

<BaseLayout title="Industry Solutions — Atlas OS for Retail, Wholesale & Distribution"
  description="Explore Atlas OS for small shops, fertilizer and agri-input dealers, e-commerce, general trade, electrical, electronics, and hardware businesses.">
  <div class="bg-surface-secondary">
    <Container size="wide" class="py-12 sm:py-16">
      <div data-enter class="mb-8 max-w-3xl space-y-3 sm:mb-10">
        <h1 class="font-heading text-4xl font-extrabold tracking-tight sm:text-5xl">Atlas OS by industry</h1>
        <p class="text-lg leading-relaxed text-content-secondary">Explore how Atlas OS handles stock, sales, and collections in your line of trade.</p>
      </div>
      <ul data-reveal-group class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {INDUSTRY_SOLUTIONS.map(industry => (
          <li id={industry.id} style={`--industry-accent:${INDUSTRY_COLORS[industry.id as keyof typeof INDUSTRY_COLORS].color};--industry-tint:${INDUSTRY_COLORS[industry.id as keyof typeof INDUSTRY_COLORS].tint}`}>
            <a href={industryDownloadHref(industry.id)} class="flex h-full flex-col gap-3 rounded-2xl border border-border bg-[var(--industry-tint)] p-5 hover:border-[var(--industry-accent)] sm:p-6">
              <h2 class="font-heading text-xl font-bold">{industry.title}</h2>
              <p class="text-sm leading-relaxed text-content-secondary">{industry.tagline}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[var(--industry-accent)]">View tool and downloads <ArrowRight size={16} aria-hidden="true" /></span>
            </a>
          </li>
        ))}
      </ul>
      <div data-reveal class="mt-9 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-brand-200 bg-brand-50 p-5 sm:p-7">
        <h2 class="font-heading text-xl font-bold">Discuss your business workflow</h2>
        <Button href="/request-demo" variant="primary" size="md">Request a demo</Button>
      </div>
    </Container>
  </div>
</BaseLayout>
