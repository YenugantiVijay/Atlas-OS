---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import PricingTable from '../components/pricing/PricingTable.astro';
import { FAQS } from '../data/faqs';

const pricingFaqs = FAQS.filter((f) => f.category === 'Pricing & Trials');
---

<BaseLayout
  title="Pricing & SaaS Plans — Atlas OS Business Operating System"
  description="Compare proposed Starter, Professional and Enterprise Network pricing for retailers and distributors."
>
  {/* HERO */}
  <section class="py-10 sm:py-14 bg-radial-glow border-b border-border/50">
    <Container size="default">
      <div class="text-center max-w-3xl mx-auto space-y-3" data-enter>
        <h1 class="text-4xl sm:text-5xl font-extrabold font-heading tracking-tight text-content-primary">
          Plans for your business
        </h1>
        <p class="text-base sm:text-lg text-content-secondary leading-relaxed">
          Start with everyday shop tools or add purchasing and counter controls as you grow.
        </p>
      </div>
    </Container>
  </section>

  {/* PRICING TABLE COMPONENT */}
  <section class="py-8 sm:py-12 bg-white border-b border-border" id="tiers">
    <Container size="default">
      <PricingTable />
    </Container>
  </section>

  {/* PRICING FAQS */}
  <section class="py-20 bg-surface-secondary border-b border-border" id="trial">
    <Container size="narrow">
      <div class="space-y-10">
        <div class="text-center space-y-2">
          <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider bg-cream-200 text-cream-700">
            Commercial Questions
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading text-content-primary">
            Frequently Asked Pricing Questions
          </h2>
          <p class="text-xs sm:text-sm text-content-secondary">
            Everything you need to know about our upcoming commercial launch, trial access, and subscription models.
          </p>
        </div>

        <div class="space-y-4">
          {pricingFaqs.map((faq) => (
            <div class="p-6 rounded-2xl border border-border bg-white shadow-2xs space-y-2">
              <h3 class="text-sm font-bold font-heading text-content-primary">{faq.question}</h3>
              <p class="text-xs text-content-secondary leading-relaxed">{faq.answer}</p>
            </div>
          ))}

          <div class="p-6 rounded-2xl border border-border bg-white shadow-2xs space-y-2">
            <h3 class="text-sm font-bold font-heading text-content-primary">
              Will existing legacy software data (BUSY / Tally) be migrated?
            </h3>
            <p class="text-xs text-content-secondary leading-relaxed">
              Legacy data migration is being evaluated. We cannot promise automatic BUSY or Tally imports yet; tell us what data you need to move when requesting a demonstration.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* CTA */}
  <section class="py-16 bg-white">
    <Container size="default">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <h3 class="text-2xl font-bold font-heading text-content-primary">Have custom enterprise volume requirements?</h3>
        <p class="text-xs sm:text-sm text-content-secondary leading-relaxed">
          Tell us how many locations, counters, and teams you need to support. We’ll discuss what can be included in your rollout.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <Button href="/request-demo" variant="primary" size="md" class="font-semibold">
            <span>Contact Commercial Team</span>
          </Button>
          <Button href="/features" variant="outline" size="md" class="font-semibold">
            <span>Review Full Module Directory</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
