---
interface Props {
  variant?: 'violet' | 'brand' | 'neutral' | 'success' | 'warning' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
  className?: string;
}

const { 
  variant = 'violet', 
  size = 'sm', 
  class: propClass = '', 
  className: propClassName = '' 
} = Astro.props;

const className = propClass || propClassName;
const normalizedVariant = variant === 'brand' ? 'violet' : variant;

const variantClasses = {
  violet: 'bg-brand-50 text-brand-700 border-brand-200/60',
  neutral: 'bg-surface-secondary text-content-secondary border-border',
  success: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  warning: 'bg-amber-50 text-amber-700 border-amber-200',
  outline: 'bg-transparent text-brand-600 border-brand-300',
};

const sizeClasses = {
  sm: 'px-2.5 py-0.5 text-xs font-medium',
  md: 'px-3 py-1 text-xs font-semibold tracking-wide uppercase',
};
---

<span class={`inline-flex items-center rounded-full border shadow-2xs font-display ${variantClasses[normalizedVariant]} ${sizeClasses[size]} ${className}`}>
  <slot />
</span>
