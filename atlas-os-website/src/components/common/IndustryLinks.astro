---
import { CircuitBoard, ShoppingBag, ShoppingBasket, Store, Wrench, Zap, Leaf, Printer, IceCreamCone, Snowflake } from 'lucide-react';
import { INDUSTRY_COLORS } from '../../data/industry-colors';
import { industryDownloadHref } from '../../data/industry-downloads';
import { INDUSTRY_NAVIGATION } from '../../data/navigation';

const icons = { electrical: Zap, electronics: CircuitBoard, hardware: Wrench, retail: ShoppingBasket,
  shop: Store, ecommerce: ShoppingBag, agriculture: Leaf, printer: Printer, icecreamcone: IceCreamCone, snowflake: Snowflake };
---

<ul class="industry-links">
  {INDUSTRY_NAVIGATION.map(({ icon, label, href, description }) => {
    const Icon = icons[icon];
    const key = href.split('/').filter(Boolean).at(-1) as keyof typeof INDUSTRY_COLORS;
    const { color, tint } = INDUSTRY_COLORS[key];
    return (
      <li class="min-w-0">
        <a href={industryDownloadHref(key)} style={`--icon-accent:${color};--industry-tint:${tint}`} class="atlas-icon-card flex h-full items-start gap-3 rounded-xl border border-border bg-surface-secondary p-3.5
          text-content-primary transition-colors hover:border-[var(--icon-accent)] hover:bg-[var(--industry-tint)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
          <span class="atlas-card-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg">
            <Icon size={18} aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold leading-snug">{label}</span>
            <span class="mt-1 hidden text-xs leading-relaxed text-content-secondary lg:block">{description}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>
<a href="/download/school/" class="mt-3 inline-flex rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:underline">School Management →</a>

<style>
  .industry-links { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
  @media (min-width: 490px) { .industry-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .industry-links { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1440px) { .industry-links { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>
