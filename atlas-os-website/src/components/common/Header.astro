---
import BrandLogo from './BrandLogo.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import { MAIN_NAVIGATION } from '../../data/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-50 w-full glass-card border-b border-border transition-all duration-200" id="site-header">
  <Container size="default">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo -->
      <div class="flex items-center gap-8">
        <BrandLogo size="md" />

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1.5" aria-label="Main Navigation">
          {
            MAIN_NAVIGATION.map((item) => {
              const hasDropdown = 'dropdown' in item && item.dropdown && item.dropdown.length > 0;
              const isActive = currentPath === item.href || (hasDropdown && item.dropdown.some((d) => currentPath.startsWith(d.href.split('#')[0])));

              if (hasDropdown) {
                return (
                  <div class="relative group">
                    <button
                      type="button"
                      class={`flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 cursor-pointer ${
                        isActive
                          ? 'text-brand-700 bg-brand-50 font-semibold'
                          : 'text-content-primary hover:text-brand-600 hover:bg-surface-secondary'
                      }`}
                      aria-expanded="false"
                      aria-haspopup="true"
                    >
                      <span>{item.label}</span>
                      <svg class="w-4 h-4 text-content-secondary group-hover:text-brand-600 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                      </svg>
                    </button>

                    <!-- Dropdown Panel -->
                    <div class="absolute left-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200 transform origin-top -translate-y-1 group-hover:translate-y-0">
                      <div class="p-2.5 rounded-2xl bg-white shadow-xl border border-border">
                        {item.dropdown.map((sub) => (
                          <a
                            href={sub.href}
                            class="flex flex-col gap-0.5 p-3 rounded-xl hover:bg-brand-50/70 transition-colors group/item"
                          >
                            <span class="text-sm font-semibold text-content-primary group-hover/item:text-brand-700">
                              {sub.label}
                            </span>
                            {sub.description && (
                              <span class="text-xs text-content-secondary line-clamp-1">
                                {sub.description}
                              </span>
                            )}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              }

              return (
                <a
                  href={item.href}
                  class={`relative flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 ${
                    isActive
                      ? 'text-brand-700 bg-brand-50 font-semibold'
                      : 'text-content-primary hover:text-brand-600 hover:bg-surface-secondary'
                  }`}
                >
                  <span>{item.label}</span>
                  {item.badge && (
                    <span class="px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-md bg-brand-100 text-brand-700">
                      {item.badge}
                    </span>
                  )}
                </a>
              );
            })
          }
        </nav>
      </div>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <Button href="/download" variant="outline" size="sm" class="hidden md:inline-flex">
          <svg class="w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          <span>Download</span>
        </Button>
        <Button href="/request-demo" variant="primary" size="sm">
          <span>Request Demo</span>
          <svg class="w-4 h-4 ml-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden gap-2">
        <Button href="/request-demo" variant="primary" size="sm" class="sm:hidden text-xs px-2.5 py-1.5">
          <span>Demo</span>
        </Button>
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-xl border border-border text-content-primary hover:bg-surface-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          aria-label="Open Navigation Menu"
        >
          <svg id="menu-open-icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-b border-border bg-white px-4 pt-4 pb-8 space-y-4 max-h-[80vh] overflow-y-auto animate-fade-in shadow-xl"
  >
    <div class="flex flex-col space-y-1">
      {
        MAIN_NAVIGATION.map((item) => {
          const hasDropdown = 'dropdown' in item && item.dropdown && item.dropdown.length > 0;
          return (
            <div class="border-b border-border/50 py-1.5">
              <a
                href={item.href}
                class="flex items-center justify-between py-2 text-base font-semibold text-content-primary hover:text-brand-600"
              >
                <span>{item.label}</span>
                {item.badge && (
                  <span class="px-2 py-0.5 text-xs font-bold rounded-md bg-brand-100 text-brand-700">
                    {item.badge}
                  </span>
                )}
              </a>
              {hasDropdown && (
                <div class="pl-3 py-1 space-y-1.5">
                  {item.dropdown.map((sub) => (
                    <a
                      href={sub.href}
                      class="block py-1 text-xs text-content-secondary hover:text-brand-600"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="pt-4 flex flex-col gap-3">
      <Button href="/download" variant="outline" size="md" class="w-full justify-center">
        <svg class="w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" x2="12" y1="15" y2="3"/>
        </svg>
        <span>Download Desktop App</span>
      </Button>
      <Button href="/request-demo" variant="primary" size="md" class="w-full justify-center">
        <span>Request Guided Demonstration</span>
      </Button>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (menuBtn && mobileNav && openIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close when clicking mobile links
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
