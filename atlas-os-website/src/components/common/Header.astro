---
import BrandLogo from './BrandLogo.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import IndustryLinks from './IndustryLinks.astro';
import GstMenu from './GstMenu.astro';
import { MAIN_NAVIGATION } from '../../data/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const onSolutions = currentPath === '/solutions' || currentPath.startsWith('/solutions/');
---

<header class="sticky top-0 z-50 w-full border-b border-border site-nav-surface" id="site-header">
  <Container size="default">
    <div class="flex h-20 items-center justify-between lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <!-- Brand Logo -->
      <div class="flex h-full items-center lg:justify-self-start">
        <BrandLogo size="md" />
      </div>

        <!-- Desktop Navigation Links -->
        <nav class="hidden h-full items-center gap-1 lg:flex lg:justify-self-center xl:gap-1.5" aria-label="Main Navigation">
          {
            MAIN_NAVIGATION.map((item) => {
              if (item.href === '/solutions' || item.href === '/gst-calculator') {
                const isGst = item.href === '/gst-calculator';
                const key = isGst ? 'gst' : 'industries';
                const active = isGst ? currentPath.replace(/\/$/, '') === item.href : onSolutions;
                return (
                  <div id={key + '-nav'} data-mega-nav class="flex h-full items-center">
                    <button id={key + '-toggle'} data-mega-toggle type="button" aria-expanded="false" aria-controls={key + '-panel'}
                      class:list={[
                        'flex items-center gap-1.5 rounded-lg px-2 py-2 text-sm font-medium hover:bg-brand-50 hover:text-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-500 aria-expanded:bg-brand-50 aria-expanded:text-brand-700 xl:px-3.5',
                        active ? 'bg-brand-50 text-brand-700' : 'text-content-primary',
                      ]}>
                      {item.label}
                      <svg aria-hidden="true" viewBox="0 0 16 16" class="mega-chevron h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <div id={key + '-panel'} data-mega-panel hidden
                      class="mega-panel site-nav-surface absolute inset-x-0 top-full overflow-y-auto overscroll-contain border-y border-border shadow-xl">
                      {isGst ? <Container size="wide" class="py-7"><GstMenu /></Container> : <Container size="wide" class="grid gap-7 py-7 lg:grid-cols-[13rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)]">
                        <div class="border-r border-border pr-5">
                          <h2 class="mb-3 text-sm font-semibold text-content-primary">Explore Atlas OS</h2>
                          <div class="grid gap-1 text-sm text-content-secondary">
                            <a href="/features" class="rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-700">Feature directory</a>
                            <a href="/receipt-templates" class="rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-700">Receipt templates</a>
                            <a href="/request-demo" class="rounded-lg px-3 py-2 hover:bg-brand-50 hover:text-brand-700">Request a workflow demo</a>
                          </div>
                        </div>
                        <div class="min-w-0">
                          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                            <h2 class="text-sm font-semibold text-content-primary">Industry solutions</h2>
                            <a href="/solutions" class="rounded text-sm font-semibold text-brand-700 hover:underline">View all industries</a>
                          </div>
                          <IndustryLinks />
                        </div>
                      </Container>}
                    </div>
                  </div>
                );
              }
              const hasDropdown = 'dropdown' in item && item.dropdown && item.dropdown.length > 0;
              const isActive = currentPath === item.href || (hasDropdown && item.dropdown.some((d) => currentPath.startsWith(d.href.split('#')[0])));

              if (hasDropdown) {
                return (
                  <div class="relative group">
                    <button
                      type="button"
                      class={`flex items-center gap-1.5 px-2 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 cursor-pointer xl:px-3.5 ${
                        isActive
                          ? 'text-brand-700 bg-brand-50 font-semibold'
                          : 'text-content-primary hover:text-brand-600 hover:bg-surface-secondary'
                      }`}
                      aria-expanded="false"
                      aria-haspopup="true"
                    >
                      <span>{item.label}</span>
                      <svg class="w-4 h-4 text-content-secondary group-hover:text-brand-600 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                      </svg>
                    </button>

                    <!-- Dropdown Panel -->
                    <div class="absolute left-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200 transform origin-top -translate-y-1 group-hover:translate-y-0">
                      <div class="p-2.5 rounded-2xl bg-white shadow-xl border border-border">
                        {item.dropdown.map((sub) => (
                          <a
                            href={sub.href}
                            class="flex flex-col gap-0.5 p-3 rounded-xl hover:bg-brand-50/70 transition-colors group/item"
                          >
                            <span class="text-sm font-semibold text-content-primary group-hover/item:text-brand-700">
                              {sub.label}
                            </span>
                            {sub.description && (
                              <span class="text-xs text-content-secondary line-clamp-1">
                                {sub.description}
                              </span>
                            )}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              }

              return (
                <a
                  href={item.href}
                  class={`relative flex items-center gap-1.5 px-2 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 xl:px-3.5 ${
                    isActive
                      ? 'text-brand-700 bg-brand-50 font-semibold'
                      : 'text-content-primary hover:text-brand-600 hover:bg-surface-secondary'
                  }`}
                >
                  <span>{item.label}</span>
                </a>
              );
            })
          }
        </nav>

      <!-- Action Buttons -->
      <div class="hidden items-center gap-3 sm:flex lg:justify-self-end">
        <Button href="/download" variant="outline" size="md" class="site-header-cta hidden md:inline-flex">
          <svg class="w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          <span class="lg:sr-only xl:not-sr-only">Download</span>
        </Button>
        <Button href="/request-demo" variant="primary" size="md" class="site-header-cta">
          <span>Request Demo</span>
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden gap-2">
        <Button href="/request-demo" variant="primary" size="sm" class="site-header-cta sm:hidden">
          <span>Demo</span>
        </Button>
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-xl border border-border text-content-primary hover:bg-surface-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          aria-label="Open Navigation Menu"
        >
          <svg id="menu-open-icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden lg:hidden border-b border-border site-nav-surface px-4 pt-4 pb-8 space-y-4 max-h-[80vh] overflow-y-auto animate-fade-in shadow-xl"
  >
    <div class="flex flex-col space-y-1">
      {
        MAIN_NAVIGATION.map((item) => {
          if (item.href === '/solutions' || item.href === '/gst-calculator') {
            const isGst = item.href === '/gst-calculator';
            return (
              <details class="group border-b border-border/50 py-1.5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-2 text-base font-semibold text-content-primary hover:text-brand-700">
                  {item.label}
                  <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                {isGst ? <GstMenu /> : <>
                <IndustryLinks />
                <a href="/solutions" class="mt-1 block py-2 text-sm font-semibold text-brand-700 hover:underline">View all industries</a>
                </>}
              </details>
            );
          }
          const hasDropdown = 'dropdown' in item && item.dropdown && item.dropdown.length > 0;
          return (
            <div class="border-b border-border/50 py-1.5">
              <a
                href={item.href}
                class="flex items-center justify-between py-2 text-base font-semibold text-content-primary hover:text-brand-600"
              >
                <span>{item.label}</span>
              </a>
              {hasDropdown && (
                <div class="pl-3 py-1 space-y-1.5">
                  {item.dropdown.map((sub) => (
                    <a
                      href={sub.href}
                      class="block py-1 text-xs text-content-secondary hover:text-brand-600"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="pt-4 flex flex-col gap-3">
      <Button href="/download" variant="outline" size="md" class="w-full justify-center">
        <svg class="w-4 h-4 text-brand-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" x2="12" y1="15" y2="3"/>
        </svg>
        <span>Download Desktop App</span>
      </Button>
      <Button href="/request-demo" variant="primary" size="md" class="w-full justify-center">
        <span>Request Guided Demonstration</span>
      </Button>
    </div>
  </div>
  <div class="atlas-scroll-progress" aria-hidden="true"></div>
</header>

<style>
  .site-nav-surface { background: white; }
  @supports (backdrop-filter: blur(1px)) {
    .site-nav-surface { background: rgb(255 255 255 / 90%); backdrop-filter: blur(16px) saturate(140%); }
  }

  .mega-panel {
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
  }

  [data-mega-toggle][aria-expanded="true"] .mega-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mega-nav]').forEach((nav) => {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-mega-toggle]');
    const panel = nav.querySelector<HTMLElement>('[data-mega-panel]');
    if (!toggle || !panel) return;
    const setOpen = (open: boolean) => {
      if (open) {
        document.querySelectorAll<HTMLElement>('[data-mega-panel]:not([hidden])').forEach((other) => {
          if (other === panel) return;
          other.hidden = true;
          other.parentElement?.querySelector('[data-mega-toggle]')?.setAttribute('aria-expanded', 'false');
        });
      }
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    nav.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') setOpen(true);
    });
    nav.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse' && !panel.contains(document.activeElement)) setOpen(false);
    });
    toggle.addEventListener('click', (event) => {
      const mouseClick = event instanceof PointerEvent && event.pointerType === 'mouse';
      setOpen(mouseClick || panel.hidden);
    });
    nav.parentElement?.querySelectorAll(':scope > *').forEach((item) => {
      if (item === nav) return;
      item.addEventListener('pointerenter', () => {
        if (!panel.contains(document.activeElement)) setOpen(false);
      });
    });
    nav.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !nav.contains(event.relatedTarget)) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        if (nav.contains(document.activeElement)) toggle.focus();
        setOpen(false);
      }
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (menuBtn && mobileNav && openIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close when clicking mobile links
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
