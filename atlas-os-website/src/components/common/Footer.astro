---
import { Facebook, Github, Instagram, Linkedin, Mail, Youtube } from 'lucide-react';
import BrandLogo from './BrandLogo.astro';
import Container from './Container.astro';
import { FOOTER_SECTIONS } from '../../data/navigation';
import { APP_CONFIG } from '../../data/releases';

const httpsUrl = (href: string | undefined): href is string =>
  typeof href === 'string' && URL.canParse(href) && new URL(href).protocol === 'https:';
const configuredLinkedIn = import.meta.env.PUBLIC_LINKEDIN_URL;
const linkedInProfile = httpsUrl(configuredLinkedIn) ? configuredLinkedIn : undefined;
const officialSite = Astro.site?.origin ?? 'https://atlasos.business';
const socialLinks = [
  { label: 'Atlas OS on GitHub', href: APP_CONFIG.githubUrl, Icon: Github },
  { label: linkedInProfile ? 'Atlas OS on LinkedIn' : 'Share Atlas OS on LinkedIn',
    href: linkedInProfile || 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(officialSite), Icon: Linkedin },
  { label: 'Atlas OS on YouTube', href: import.meta.env.PUBLIC_YOUTUBE_URL, Icon: Youtube },
  { label: 'Atlas OS on Instagram', href: import.meta.env.PUBLIC_INSTAGRAM_URL, Icon: Instagram },
  { label: 'Atlas OS on Facebook', href: import.meta.env.PUBLIC_FACEBOOK_URL, Icon: Facebook },
].filter(({ href }) => httpsUrl(href));
---

<footer class="bg-surface-secondary border-t border-border mt-auto py-9 sm:py-12 text-content-primary">
  <Container size="wide">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border pb-5">
      <BrandLogo size="md" />
      <a href="/request-demo" class="text-sm font-semibold text-brand-700 hover:underline">Book a walkthrough</a>
    </div>
    <div class="grid grid-cols-2 gap-x-5 gap-y-7 border-b border-border py-7 md:grid-cols-4 md:gap-x-9">
      <!-- Navigation Columns -->
      {
        FOOTER_SECTIONS.map((section) => (
          <div class="min-w-0 space-y-2.5">
            <h2 class="footer-heading border-b border-border pb-2 font-semibold text-content-primary">
              {section.title}
            </h2>
            <ul class="space-y-1">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link inline-block py-1 text-content-secondary hover:text-brand-700 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border py-5">
      <div>
        <p class="font-semibold">Need help with Atlas OS?</p>
        <a class="mt-1 inline-flex items-center gap-2 text-sm text-brand-700 hover:underline" href={'mailto:' + APP_CONFIG.supportEmail}>
          <Mail size={16} aria-hidden="true" />{APP_CONFIG.supportEmail}
        </a>
      </div>
      <a href="/support" class="rounded-lg border border-border bg-white px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">Visit Help Center</a>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pb-8 pr-16 pt-5 text-xs sm:pb-0 text-content-secondary">
      <p>© {new Date().getFullYear()} Atlas OS Technologies. All rights reserved.</p>
      <nav aria-label="Atlas OS social links" class="flex flex-wrap justify-center gap-2">
        {socialLinks.map(({ label, href, Icon }) => (
          <a href={href} aria-label={label} title={label}
            class="grid h-10 w-10 place-items-center rounded-full border border-border bg-white text-content-secondary hover:border-brand-300 hover:bg-brand-50 hover:text-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
            <Icon size={18} aria-hidden="true" />
          </a>
        ))}
      </nav>
    </div>
  </Container>
</footer>
