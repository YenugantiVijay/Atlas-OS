---
import BrandLogo from './BrandLogo.astro';
import Container from './Container.astro';
import { FOOTER_SECTIONS } from '../../data/navigation';
---

<footer class="bg-surface-secondary border-t border-border mt-auto py-9 sm:py-12 text-content-primary">
  <Container size="default">
    <div class="site-footer-grid grid grid-cols-1 gap-x-7 gap-y-7 border-b border-border pb-8 sm:grid-cols-2">
      <!-- Brand & Mission Column -->
      <div class="site-footer-brand space-y-3 sm:col-span-2">
        <BrandLogo size="md" />
        <p class="text-sm text-content-secondary leading-relaxed max-w-sm">
          Manage stock, sales, invoices, and payments in one workspace for shops, wholesalers, and distributors.
        </p>

        <div class="pt-2 space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Enterprise Web Application Active</span>
          </div>
          <p class="text-xs text-content-secondary">
            Standalone Windows Desktop Installer currently in packaging preview.
          </p>
        </div>
      </div>

      <!-- Navigation Columns -->
      {
        FOOTER_SECTIONS.map((section) => (
          <div class="min-w-0 space-y-2.5">
            <h2 class="footer-heading font-semibold text-content-primary">
              {section.title}
            </h2>
            <ul class="space-y-1">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link inline-block py-1 text-content-secondary hover:text-brand-700 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Attribution & Disclosures -->
    <div class="pt-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-content-secondary">
      <div class="space-y-1 text-center sm:text-left">
        <p>© {new Date().getFullYear()} Atlas OS Technologies. All rights reserved.</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/security" class="hover:text-brand-600 transition-colors">Security Architecture</a>
        <a href="/support" class="hover:text-brand-600 transition-colors">Help Center</a>
        <a href="/contact" class="hover:text-brand-600 transition-colors">Contact Sales</a>
      </div>
    </div>
  </Container>
</footer>
