---
import BrandLogo from './BrandLogo.astro';
import Container from './Container.astro';
import { FOOTER_SECTIONS } from '../../data/navigation';
---

<footer class="bg-surface-secondary border-t border-border mt-auto pt-16 pb-12 text-content-primary">
  <Container size="default">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-10 pb-12 border-b border-border">
      <!-- Brand & Mission Column -->
      <div class="sm:col-span-2 lg:col-span-2 space-y-4">
        <BrandLogo size="lg" />
        <p class="text-sm text-content-secondary leading-relaxed max-w-sm">
          The AI-native business operating system for modern electrical, electronics, and hardware distributors.
          Manage inventory, sales orders, GST invoices, and accounts receivable from one connected workspace.
        </p>

        <div class="pt-2 space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Enterprise Web Application Active</span>
          </div>
          <p class="text-xs text-content-secondary">
            Standalone Windows Desktop Installer currently in packaging preview.
          </p>
        </div>
      </div>

      <!-- Navigation Columns -->
      {
        FOOTER_SECTIONS.map((section) => (
          <div class="space-y-4">
            <h4 class="footer-heading text-[17px] sm:text-[18px] font-bold font-heading text-[#142B4D] tracking-tight">
              {section.title}
            </h4>
            <ul class="space-y-2.5 text-[14.5px] sm:text-[15px]">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link text-content-secondary hover:text-brand-600 transition-all duration-150 hover:translate-x-1 inline-block py-0.5"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Attribution & Disclosures -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-content-secondary">
      <div class="space-y-1 text-center sm:text-left">
        <p>© {new Date().getFullYear()} Atlas OS Technologies. All rights reserved.</p>
        <p class="text-[11px] text-content-secondary/80">
          Built for electrical, electronics, and hardware distributors, wholesalers, and retail trade counters.
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a href="/security" class="hover:text-brand-600 transition-colors">Security Architecture</a>
        <a href="/support" class="hover:text-brand-600 transition-colors">Help Center</a>
        <a href="/contact" class="hover:text-brand-600 transition-colors">Contact Sales</a>
      </div>
    </div>
  </Container>
</footer>
