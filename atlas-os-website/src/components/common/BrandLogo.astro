---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const { size = 'md', showText = true, class: className = '' } = Astro.props;

const iconSizes = {
  sm: 'w-7 h-7',
  md: 'w-9 h-9',
  lg: 'w-11 h-11',
};

const textSizes = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl',
};
---

<a href="/" class={`inline-flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg p-0.5 ${className}`} aria-label="Atlas OS Home">
  <div class={`${iconSizes[size]} transition-transform duration-200 group-hover:scale-105 shrink-0`}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" class="w-full h-full shadow-sm rounded-lg" aria-hidden="true">
      <rect x="4" y="4" width="40" height="40" rx="10" fill="#142B4D"/>
      <path d="M24 8L38 16V32L24 40L10 32V16L24 8Z" stroke="#CCFBF1" stroke-width="3" stroke-linejoin="round"/>
      <path d="M24 8V24L38 32" stroke="#2DD4BF" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M24 24L10 32" stroke="#2DD4BF" stroke-width="2.5" stroke-linejoin="round"/>
      <circle cx="24" cy="24" r="4.5" fill="#0D9488"/>
      <circle cx="24" cy="24" r="2" fill="#CCFBF1"/>
    </svg>
  </div>
  {showText && (
    <div class="flex items-baseline tracking-tight">
      <span class={`${textSizes[size]} font-extrabold text-content-primary font-display`}>ATLAS</span>
      <span class={`${textSizes[size]} font-extrabold text-brand-600 font-display ml-1`}>OS</span>
    </div>
  )}
</a>
