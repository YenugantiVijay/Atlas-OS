---
/**
 * THE CONNECTED BUSINESS ECOSYSTEM
 * Signature Floating Capability Animation for Atlas OS
 * Demonstrates the unified workflow between stock, orders, invoices, payments, reports, and AI.
 * Fully accessible with prefers-reduced-motion fallback and mobile-responsive static grid.
 */
---

<section class="capability-orbit" aria-label="Atlas OS Connected Business Ecosystem">
  <!-- Subtle Ambient Background Grid & Orbit Pathways -->
  <div class="orbit-grid" aria-hidden="true"></div>
  <div class="orbit-ring orbit-ring-inner" aria-hidden="true"></div>
  <div class="orbit-ring orbit-ring-outer" aria-hidden="true"></div>

  <!-- Central Atlas OS Ecosystem Hub -->
  <div class="orbit-core">
    <span class="orbit-eyebrow">THE CONNECTED BUSINESS ECOSYSTEM</span>
    <div class="orbit-emblem" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" width="54" height="54">
        <rect x="4" y="4" width="40" height="40" rx="12" fill="#142B4D"/>
        <path d="M24 10L36 17V31L24 38L12 31V17L24 10Z" stroke="#CCFBF1" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M24 10V24L36 31M24 24L12 31" stroke="#2DD4BF" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="24" cy="24" r="4" fill="#0D9488"/>
        <circle cx="24" cy="24" r="1.8" fill="#CCFBF1"/>
      </svg>
    </div>
    <h2>One connected<br/><span>business system.</span></h2>
    <p>Every daily workflow in harmony—without manual paperwork.</p>
  </div>

  <!-- Floating Capability Nodes -->
  <ul class="orbit-nodes" aria-label="Connected capabilities">
    <!-- 1. Inventory -->
    <li class="orbit-chip chip-inventory" title="Inventory: Know What's in Stock">
      <span class="chip-icon icon-inventory" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
          <path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">Inventory</strong>
        <small>Know what's in stock</small>
      </div>
    </li>

    <!-- 2. Sales Orders -->
    <li class="orbit-chip chip-orders" title="Sales Orders: Manage Customer Orders">
      <span class="chip-icon icon-orders" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="4" width="14" height="17" rx="2"/>
          <path d="M9 4.5V3h6v1.5M9 10h6M9 14h6M9 18h3"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">Sales Orders</strong>
        <small>Manage customer orders</small>
      </div>
    </li>

    <!-- 3. Invoices -->
    <li class="orbit-chip chip-invoices" title="Invoices: Keep Billing Organized">
      <span class="chip-icon icon-invoices" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/>
          <path d="M9 8h6M9 12h6M9 16h3"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">Invoices</strong>
        <small>Keep billing organized</small>
      </div>
    </li>

    <!-- 4. Payments -->
    <li class="orbit-chip chip-payments" title="Payments: Track Money Received">
      <span class="chip-icon icon-payments" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="5" width="19" height="14" rx="3"/>
          <path d="M2.5 10h19M15 15h3"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">Payments</strong>
        <small>Track money received</small>
      </div>
    </li>

    <!-- 5. Reports -->
    <li class="orbit-chip chip-reports" title="Reports: Understand Your Business">
      <span class="chip-icon icon-reports" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 3v18h17M8 16l4-5 3 2 5-7"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">Reports</strong>
        <small>Understand your business</small>
      </div>
    </li>

    <!-- 6. AI Insights -->
    <li class="orbit-chip chip-ai" title="AI Insights: Smarter Assistance">
      <span class="chip-icon icon-ai" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3ZM19 17l.7 2.3L22 20l-2.3.7L19 23l-.7-2.3L16 20l2.3-.7L19 17Z"/>
        </svg>
      </span>
      <div class="chip-content">
        <strong class="font-heading">AI Insights</strong>
        <small>Smarter assistance (Preview)</small>
      </div>
    </li>
  </ul>

  <!-- Ecosystem Sub-Label -->
  <span class="orbit-footnote">INTEGRATED COMMERCE WORKSPACE · BUILT FOR DISTRIBUTORS</span>
</section>

<style>
  .capability-orbit {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 560px;
    border: 1px solid #d5e7e6;
    border-radius: 28px;
    background: radial-gradient(circle at 50% 50%, #e6faf5 0%, #f4fbfa 38%, #f8fafc 72%, #f0f4f8 100%);
    box-shadow: 0 20px 50px -30px rgba(20, 43, 77, 0.25);
  }

  .orbit-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(13, 148, 136, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 148, 136, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at center, #000 15%, transparent 80%);
    pointer-events: none;
  }

  .orbit-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1.5px dashed rgba(13, 148, 136, 0.22);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-ring-inner {
    width: 460px;
    height: 290px;
  }

  .orbit-ring-outer {
    width: 820px;
    height: 430px;
    border-color: rgba(20, 43, 77, 0.12);
  }

  .orbit-core {
    position: absolute;
    z-index: 1;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(320px, 88%);
    text-align: center;
  }

  .orbit-eyebrow {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.18em;
    font-weight: 700;
    color: #0f766e;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .orbit-emblem {
    display: grid;
    place-items: center;
    margin: 0 auto 12px;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    background: #142b4d;
    box-shadow: 0 14px 34px -10px rgba(20, 43, 77, 0.45), 0 0 0 6px rgba(13, 148, 136, 0.12);
    transition: transform 0.3s ease;
  }

  .capability-orbit:hover .orbit-emblem {
    transform: scale(1.04);
  }

  .orbit-core h2 {
    color: #142b4d;
    font-family: 'Poppins', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 32px);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .orbit-core h2 span {
    color: #0d9488;
  }

  .orbit-core p {
    font-size: 12px;
    color: #64748b;
    margin-top: 8px;
    line-height: 1.4;
  }

  .orbit-nodes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orbit-chip {
    --dx: 40px;
    --dy: 10px;
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 175px;
    padding: 10px 14px;
    border-radius: 16px;
    border: 1px solid #d6e8e6;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 10px 25px -12px rgba(20, 43, 77, 0.22);
    backdrop-filter: blur(8px);
    animation: gather-hold 12s ease-in-out infinite;
    cursor: default;
    transition: box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  /* Hover highlight maintains keyframe motion without freeze or transform conflict */
  .orbit-chip:hover {
    box-shadow: 0 16px 36px -10px rgba(13, 148, 136, 0.35), 0 0 0 2px rgba(13, 148, 136, 0.18);
    border-color: #0d9488;
    background: #ffffff;
  }

  .chip-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    flex-shrink: 0;
    place-items: center;
  }

  .chip-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Domain Color Treatments for Icons */
  .icon-inventory {
    background: #d1fae5;
    color: #059669;
  }
  .icon-orders {
    background: #e0f2fe;
    color: #0284c7;
  }
  .icon-invoices {
    background: #fee2e2;
    color: #dc2626;
  }
  .icon-payments {
    background: #ffedd5;
    color: #d97706;
  }
  .icon-reports {
    background: #f3e8ff;
    color: #7e22ce;
  }
  .icon-ai {
    background: #ccfbf1;
    color: #0d9488;
  }

  .chip-content {
    display: flex;
    flex-direction: column;
  }

  .orbit-chip strong {
    font-size: 13px;
    line-height: 1.25;
    color: #172b4d;
    font-weight: 700;
  }

  .orbit-chip small {
    font-size: 10.5px;
    line-height: 1.35;
    margin-top: 1px;
    color: #64748b;
  }

  /* Node Coordinates & Path Directions */
  .chip-inventory {
    left: 7%;
    top: 14%;
    --dx: -80px;
    --dy: -30px;
  }

  .chip-orders {
    right: 7%;
    top: 14%;
    --dx: 80px;
    --dy: -30px;
    animation-delay: -0.7s;
  }

  .chip-invoices {
    left: 3.5%;
    top: 48%;
    --dx: -90px;
    --dy: 0px;
    animation-delay: -1.4s;
  }

  .chip-payments {
    right: 3.5%;
    top: 48%;
    --dx: 90px;
    --dy: 0px;
    animation-delay: -2.1s;
  }

  .chip-reports {
    left: 9%;
    bottom: 12%;
    --dx: -80px;
    --dy: 35px;
    animation-delay: -2.8s;
  }

  .chip-ai {
    right: 9%;
    bottom: 12%;
    --dx: 80px;
    --dy: 35px;
    animation-delay: -3.5s;
  }

  .orbit-footnote {
    position: absolute;
    inset: auto 0 12px;
    text-align: center;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: #94a3b8;
    font-weight: 700;
  }

  /* Smooth Staggered Motion: Gentle Entrance -> Stable Hold -> Graceful Departure */
  @keyframes gather-hold {
    0%, 10% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.88);
    }
    26%, 70% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
    88%, 100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.88);
    }
  }

  /* Motion continues uninterrupted on hover */
  .capability-orbit:hover .orbit-chip,
  .capability-orbit:focus-within .orbit-chip {
    animation-play-state: running;
  }

  /* Mobile / Small Viewport Fallback */
  @media (max-width: 900px) {
    .capability-orbit {
      min-height: auto;
      padding: 32px 20px 24px;
    }
    .orbit-core {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: 0 auto 28px;
    }
    .orbit-ring {
      display: none;
    }
    .orbit-nodes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .orbit-chip {
      position: static;
      min-width: 0;
      width: 100%;
      animation: none;
      transform: none;
    }
    .orbit-footnote {
      position: relative;
      inset: auto;
      display: block;
      margin-top: 24px;
    }
  }

  @media (max-width: 650px) {
    .orbit-nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .orbit-chip {
      padding: 10px 10px;
      gap: 10px;
    }
    .chip-icon {
      width: 32px;
      height: 32px;
    }
    .chip-icon svg {
      width: 17px;
      height: 17px;
    }
    .orbit-chip strong {
      font-size: 12px;
    }
    .orbit-chip small {
      font-size: 9.5px;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .orbit-chip {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
