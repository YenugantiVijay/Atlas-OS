---
import type { InvoiceFormat } from '../../data/invoice-formats';
interface Props { format: InvoiceFormat }
const { format } = Astro.props;
const money = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' });
const rows = format.lines.map(([item, qty, unit, rate, taxRate]) => ({
  item, qty, unit, rate, taxRate, taxable: qty * rate, gst: Math.round(qty * rate * taxRate) / 100,
}));
const subtotal = rows.reduce((sum, row) => sum + row.taxable, 0);
const gst = rows.reduce((sum, row) => sum + row.gst, 0);
---
<figure class="overflow-hidden rounded-2xl border border-border bg-white shadow-sm">
  <figcaption class="flex flex-wrap items-center justify-between gap-2 border-b border-border bg-brand-50 px-5 py-4">
    <span class="font-heading text-lg font-bold">Sample {format.name} invoice</span>
    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-800">Illustrative amounts</span>
  </figcaption>
  <div class="p-4 sm:p-5">
    <div class="mb-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-content-secondary">
      <span><strong class="text-content-primary">Invoice</strong> SAMPLE-001</span>
      <span><strong class="text-content-primary">Bill to</strong> Example customer</span>
    </div>
    <div class="overflow-auto rounded-lg border border-border" tabindex="0" role="region" aria-label="Sample invoice line items">
      <table class="w-full min-w-[22rem] text-left text-sm">
        <thead class="bg-surface-secondary text-content-primary"><tr>
          <th scope="col" class="px-3 py-2">Description</th>
          <th scope="col" class="px-3 py-2">Quantity</th>
          <th scope="col" class="px-3 py-2 text-right">Unit rate</th>
          <th scope="col" class="px-3 py-2 text-right">Taxable amount</th>
        </tr></thead>
        <tbody>
          {rows.map(row => <tr class="border-t border-border">
            <th scope="row" class="px-3 py-2 font-medium">{row.item}</th>
            <td class="whitespace-nowrap px-3 py-2">{row.qty} {row.unit}</td>
            <td class="px-3 py-2 text-right">{money.format(row.rate)}</td>
            <td class="px-3 py-2 text-right">{money.format(row.taxable)}</td>
          </tr>)}
        </tbody>
      </table>
    </div>
    <dl class="ml-auto mt-4 grid max-w-60 gap-2 text-sm tabular-nums">
      <div class="flex justify-between gap-2"><dt>Subtotal</dt><dd>{money.format(subtotal)}</dd></div>
      <div class="flex justify-between gap-2"><dt>Illustrative GST</dt><dd>{money.format(gst)}</dd></div>
      <div class="flex justify-between gap-2 border-t border-border pt-2 font-bold text-brand-800"><dt>Total</dt><dd>{money.format(subtotal + gst)}</dd></div>
    </dl>
  </div>
</figure>
