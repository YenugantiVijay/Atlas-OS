# ATLAS OS Environment Configuration
# Copy this file to .env.local for local development.

# Supabase Project URL (Client publishable)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (Client safe - starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Legacy Supabase Anon Key (Supported as fallback alias)
# VITE_SUPABASE_ANON_KEY=

# Local Development / Demonstration Fallback
# When 'true' or when Supabase credentials are not provided, ATLAS OS uses
# the robust in-memory / local storage business logic engine with complete
# multi-tenant isolation, inventory ledgers, and transactional guarantees.
VITE_ENABLE_MOCK_FALLBACK=true

