{
  "name": "atlas-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/run_local_db_acceptance.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/operations.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx,.js,.mjs --max-warnings=0",
    "verify:fast": "npm run lint && npm run typecheck && vitest run src/services/review-regressions.test.ts src/services/products.test.ts && npm run test:e2e:smoke",
    "verify:all": "npm run lint && npm run typecheck && npm run test:db && npm test && npm run build && npm run test:e2e",
    "audit:repository": "node scripts/audit-repository.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.0.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
